// ─────────────────────────────────────────────────────────────────
// firestore.rules — LinguaWave Firestore Security Rules
//
// PUBLISH: Firebase console -> Firestore Database -> Rules tab ->
//          paste this whole file -> Publish. (Or: firebase deploy
//          --only firestore:rules if you use the Firebase CLI.)
//          Rules are per database: publish to the (default) database
//          of project linguawave-63911.
//
// WHY: The site is static, so the browser talks to Firestore directly.
//      Hiding admin pages is only cosmetic — anyone can open DevTools
//      and call the Firestore SDK. These rules are the real lock.
//
// ADMIN = the one account whose Firebase Auth email matches the string
//      in isAdmin() below. Keep it in sync with ADMIN_EMAIL in
//      js/admin-auth.js, js/role-guard.js, js/admin-login.js,
//      js/admin-firebase.js, functions/index.js and index.html.
//      (request.auth.token.email comes from Firebase, not from user data.)
//
// COLLECTIONS COVERED (everything else is denied by default):
//   users/{uid}            learner profile   (js/auth.js, admin panel)
//   signs/{id}             lesson content    (admin panel; video = R2 URL + key)
//   questions/{id}         quiz questions    (admin panel)
//   userProgress/{uid}     progress          (js/engine/progress.js)
//   userProgressV2/{uid}   missions sync     (js/missions.js)
//   userGame/{uid}         game progress     (js/game.js)          <- NEW
//   xpState/{uid}          private XP state  (Cloud Functions write; owner read)
//   publicProfiles/{uid}   leaderboard rows  (Cloud Functions write; verified read)
//   xpSessions/{uid}       game sessions     (Cloud Functions only)
//   xpEvents/{id}          XP audit records  (Cloud Functions write; admin read)
//   surveys/{id}           feedback answers  (js/feedback.js -> admin panel)
//
// CHANGED (lesson media -> Cloudflare R2): signs/{id} writes are now shape-checked
//      (field whitelist, id == signId, videoUrl https/legacy path, videoKey in the
//      Worker's videos/admin/<signId>/<ts>.mp4 format). Delete stays
//      admin-only and unconditional. Upload authorization itself is NOT done here:
//      it's the media Worker (worker/src/index.js) that checks the Firebase token.
// CHANGED (progress sync fix): learner progress (userProgress, userProgressV2,
//      userGame) is now get/create/update by the owner only, with a field
//      whitelist. NOTE: the rules alone were never the blocker — js/auth.js had
//      stopped exporting doc/db/getDoc/setDoc on window.LWAuth, so progress.js,
//      missions.js and game.js threw before any request was sent. They now use
//      LWAuth.readProgressDoc / writeProgressDoc (see js/auth.js).
// CHANGED (feedback -> admin panel): surveys/{id} used to accept ANY
//      document as long as userId matched. It now also requires:
//        - the document id to start with the caller's uid
//          (js/feedback.js ids are `${uid}_${level}_${Date.now()}`),
//          so nobody can create or collide with another learner's id;
//        - userEmail to equal the email on the caller's Firebase token,
//          so the admin panel can trust who sent it;
//        - exact field set + value whitelist for level and q1..q4, and
//          length caps on name/comment/timestamp, so junk or oversized
//          documents can't be stored.
//      Learners: create only (no read, no update, no delete).
//      Admin:    read (get + list) and delete.
//      Not enforceable here: submittedAt is an ISO *string* written by
//      the browser, so its value can't be checked against request.time.
//      (Switch feedback.js to serverTimestamp() if that ever matters.)
// ─────────────────────────────────────────────────────────────────
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Verified e-mail (password accounts must verify; Google accounts always are).
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'linguawave.project@gmail.com';
    }

    // ── users/{uid} ────────────────────────────────────────────
    match /users/{uid} {
      // Single-document read: a learner reads their own profile, the
      // admin reads any.
      allow get: if isOwner(uid) || isAdmin();

      // Listing the collection (User Management, Reports): admin only.
      allow list: if isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'level', 'joined'])
        && request.resource.data.uid == uid
        && request.resource.data.level == 'basic'
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;

      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'avatar', 'deletionRequested', 'deletionRequestedAt'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 30
            // avatar = the ID of one of the fixed pictures (js/avatars.js), never a URL/upload.
            && (!('avatar' in request.resource.data)
                || (request.resource.data.avatar is string
                    && request.resource.data.avatar.matches('^avatar-[0-9]{2}$'))));

      allow delete: if isAdmin();
    }

    // ── signs/{id}  (Lesson Management) ────────────────────────
    // Learners read; only the admin writes. The video itself lives in
    // Cloudflare R2 — the document only carries its public URL + object key.
    // The rules can't know R2 is uploaded, but they DO pin the shape so a
    // typo or a compromised admin session can't store arbitrary fields or
    // point a lesson at a non-https / non-R2-key value.
    match /signs/{id} {
      function validLesson(d) {
        return d.keys().hasOnly(['signId', 'title', 'description', 'tips', 'missionId', 'chapterId', 'order',
                                 'videoUrl', 'videoKey', 'localVideoPath', 'level', 'category',
                                 'detectionType', 'source', 'createdAt', 'updatedAt'])
          && d.signId == id
          && id.matches('^[a-z0-9][a-z0-9_-]{0,39}$')
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 60
          && d.description is string && d.description.size() <= 500
          && d.tips is list && d.tips.size() <= 10
          && d.order is number && d.order >= 0 && d.order <= 9999
          // videoUrl: empty, a public https URL (R2), or a legacy ../assets/ path.
          && d.videoUrl is string && d.videoUrl.size() <= 500
          && (d.videoUrl == '' || d.videoUrl.matches('^https://[^ ]+$') || d.videoUrl.matches('^\\.\\./assets/[^ ]+$'))
          // videoKey: empty (no R2 object) or exactly the shape the media Worker generates.
          && (!('videoKey' in d) || d.videoKey == ''
              || d.videoKey.matches('^videos/admin/[a-z0-9][a-z0-9_-]{0,39}/[0-9]{10,16}\\.mp4$'));
      }
      allow read: if signedIn();
      allow create, update: if isAdmin() && validLesson(request.resource.data);
      allow delete: if isAdmin();   // always allowed, so legacy/odd documents can still be cleaned up
    }

    // ── questions/{id}  (Quiz Management) ──────────────────────
    match /questions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── userProgress/{uid}  (js/engine/progress.js) ────────────
    // Learned/practiced signs + assessments. Doc id MUST be the caller's uid,
    // so nobody can read or write another learner's progress.
    // Reached via window.LWAuth.readProgressDoc/writeProgressDoc (js/auth.js).
    match /userProgress/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── userProgressV2/{uid}  (js/missions.js) ─────────────────
    // Missions sync: { progress, streak, hearts }. Written with merge, so
    // only the top-level keys below are accepted.
    match /userProgressV2/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['progress', 'streak', 'hearts']);
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── userGame/{uid}  (js/game.js) ───────────────────────────
    // Sign Wall game: gems, walls cleared, badges, best result per wall size.
    match /userGame/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['gems', 'walls', 'badges', 'best'])
        && request.resource.data.gems is number
        && request.resource.data.gems >= 0 && request.resource.data.gems <= 10000000
        && request.resource.data.walls is number
        && request.resource.data.walls >= 0 && request.resource.data.walls <= 10000000
        && request.resource.data.badges is list
        && request.resource.data.badges.size() <= 50
        && request.resource.data.best is map;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── xpState/{uid}  (private XP ledger; Cloud Functions only write) ──
    match /xpState/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ── publicProfiles/{uid}  (leaderboards) ───────────────────
    // Small public copy written by Cloud Functions. Lists MUST carry limit <= 100.
    match /publicProfiles/{uid} {
      allow get: if verified();
      allow list: if verified() && request.query.limit <= 100;
      allow create, update, delete: if false;
    }

    // Cloud Function owned game ledger and audit rows. No browser reads or writes.
    match /xpSessions/{uid} {
      allow read, write: if false;
    }
    match /xpEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── surveys/{id}  (js/feedback.js -> pages/admin-feedback.html) ──
    match /surveys/{id} {

      // Mirrors pages/feedback.html (radio values) and js/survey-schema.js.
      // q1..q4 are required radios; q5 is the optional comment (null when
      // left empty, so a missing q5 key is tolerated too).
      function validAnswers(a) {
        return a is map
          && a.keys().hasAll(['q1', 'q2', 'q3', 'q4'])
          && a.keys().hasOnly(['q1', 'q2', 'q3', 'q4', 'q5'])
          && a.q1 in ['1', '2', '3', '4', '5']
          && a.q2 in ['1', '2', '3', '4', '5']
          && a.q3 in ['too_easy', 'just_right', 'too_hard']
          && a.q4 in ['yes', 'maybe', 'no']
          && (!('q5' in a) || a.q5 == null
              || (a.q5 is string && a.q5.size() <= 2000));
      }

      function validSurvey(d) {
        return d.keys().hasOnly(['userId', 'userName', 'userEmail', 'level', 'answers', 'submittedAt'])
          && d.keys().hasAll(['userId', 'userName', 'userEmail', 'level', 'answers', 'submittedAt'])
          && d.userId == request.auth.uid
          && d.userName is string
          && d.userName.size() >= 1 && d.userName.size() <= 60
          && d.userEmail is string
          && request.auth.token.email != null
          && d.userEmail.lower() == request.auth.token.email.lower()
          && d.level in ['basic', 'medium', 'intermediate']
          && validAnswers(d.answers)
          && d.submittedAt is string
          && d.submittedAt.size() <= 40;
      }

      // Learner: create their OWN survey, once per document id.
      // (setDoc() onto an existing id is an *update*, which is denied
      // below — so a retry after a write that already landed is rejected
      // instead of overwriting, and nobody can overwrite anyone else.)
      allow create: if signedIn()
        && id.matches(request.auth.uid + '_.+')
        && validSurvey(request.resource.data);

      // Admin only: list + read every submission, and delete if needed.
      allow get, list, delete: if isAdmin();

      // Nobody edits a submitted survey.
      allow update: if false;
    }

    // ── everything else: denied ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
