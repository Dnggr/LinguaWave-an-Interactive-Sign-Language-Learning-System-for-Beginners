<file path="js/main.js">
/**
 * main.js — Global JavaScript Controller
 * ─────────────────────────────────────────────────────────────────
 * PURPOSE  : Shared utilities and UI behaviours that run on every
 *            page: active nav link highlighting, progress-bar
 *            animation, badge rendering, and user-detail rendering
 *            (name/email/level pulled from js/auth.js's session).
 *
 * CONNECTS : Loaded by index.html and all pages/*.html via
 *            <script src="../js/main.js"> (or ./js/main.js from root).
 *            Requires js/auth.js to be loaded first on every page.
 *
 * ─────────────────────────────────────────────────────────────────
 */

'use strict';

/* ── ACTIVE USER ──────────────────────────────────────────────────── */
/*
 * Reads the logged-in user from js/auth.js (window.LWAuth). Every
 * protected page should already have run requireAuth(), so this
 * should never be null in practice — the fallback just keeps pages
 * from crashing if auth.js hasn't loaded for some reason.
 *
 * CLEANUP (this revision) — removed MOCK_PROGRESS and the `level`/
 * `progress` fields it fed. Both were leftovers from the pre-Missions
 * curriculum (basic/medium/intermediate) and had been fully dead for
 * some time: `.progress` was never read anywhere (real progress comes
 * from window.LWMissions), and no page still has a [data-user-level]
 * hook. Only the fields initUserDetails() below actually renders remain.
 */
function getActiveUser() {
  const session = window.LWAuth?.getCurrentUser?.();
  return {
    name:  session?.name  || 'Guest',
    email: session?.email || '',
    joined: session?.joined || '',
  };
}


/* ── UTILITY: get current page filename ─────────────────────────── */
function currentPage() {
  const path = window.location.pathname;
  return path.split('/').pop() || 'index.html';
}


/* ── NAVBAR: mark active link ────────────────────────────────────── */
/*
 * Adds .active class to the navbar link whose href matches the
 * current page so the user knows where they are.
 */
function initActiveNav() {
  const page = currentPage();
  document.querySelectorAll('.navbar__links a').forEach(link => {
    if (link.getAttribute('href') === page ||
        link.getAttribute('href') === `./${page}` ||
        link.getAttribute('href') === `pages/${page}`) {
      link.classList.add('active');
    }
  });
}


/* ── SIDEBAR NAV GUARD ────────────────────────────────────────────
 * Two problems this stops on every .app-sidebar__link (Dashboard /
 * Learn / Progress / Feedback / Settings, on every page that has
 * the sidebar):
 *   1. Clicking the link for the page you're already on used to just
 *      re-navigate to the exact same URL — a full, pointless reload.
 *      Each page already hardcodes `.active` on its own current
 *      sidebar link (see e.g. pages/dashboard.html), so that's all
 *      this needs to check — no need to re-derive "current page"
 *      from the URL the way initActiveNav() above does.
 *   2. Rapid repeat clicks — same link or a different one, fired
 *      before the browser has actually left the page — could queue
 *      up more than one navigation. Once a real navigation starts,
 *      further clicks on ANY sidebar link are ignored until this
 *      page actually unloads.
 * Only plain left-clicks are intercepted; Ctrl/Cmd/Shift-click and
 * middle-click (open in a new tab) are left alone.
 */
function initSidebarNavGuard() {
  const links = document.querySelectorAll('.app-sidebar__link');
  if (!links.length) return;

  let navigating = false;

  links.forEach((link) => {
    link.addEventListener('click', (e) => {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      // Already on this page, or another nav click is already in
      // flight — swallow this one instead of firing another reload.
      if (link.classList.contains('active') || navigating) {
        e.preventDefault();
        return;
      }

      navigating = true;
    });
  });

  // Bfcache restore (browser back/forward) can bring this exact JS
  // state back without DOMContentLoaded re-running — reset the flag
  // so a `navigating` left `true` from before the user left doesn't
  // permanently block the sidebar after they return.
  window.addEventListener('pageshow', () => { navigating = false; });
}


/* ── PROGRESS BARS: animate fill on page load ────────────────────── */
/*
 * Reads [data-progress="0-100"] on any .progress-bar__fill element
 * and sets --p (the fill is slid with transform, see css/style.css's
 * .progress-bar__fill) so the CSS transition plays on load.
 * TODO: replace hardcoded data attributes with values from Firestore.
 */
function initProgressBars() {
  document.querySelectorAll('.progress-bar__fill[data-progress]').forEach(el => {
    const pct = Math.min(100, Math.max(0, parseInt(el.dataset.progress, 10)));
    // Defer to next frame so transition fires
    requestAnimationFrame(() => { el.style.setProperty('--p', String(pct)); });
  });
}


/* ── TOAST NOTIFICATIONS ─────────────────────────────────────────── */
/*
 * showToast(message, type)
 * Programmatically displays a slide-in notification at the bottom
 * of the screen.  type: 'success' | 'error' | 'info'
 * Used by lesson.js to give feedback (e.g. when a locked lesson is
 * opened directly). Every page that can call this must link
 * css/toast.css — confirmed all of them do (pages/camera-practice.html was
 * missing it and has been fixed).
 */
function showToast(message, type = 'info') {
  // Remove existing toasts
  document.querySelectorAll('.toast').forEach(t => t.remove());

  const toast = document.createElement('div');
  toast.className = `toast toast--${type}`;
  toast.setAttribute('role', 'alert');
  // ICON MIGRATION — the audit's section 3 asked for one shared status
  // icon component instead of each caller prefixing its own emoji into
  // the message ('\u2705 Saved', 'Thanks! \ud83c\udf89'). The `type` argument this
  // function has always taken is now the only thing that picks the
  // icon, so callers pass plain text and can't disagree with it.
  // setLabel() over innerHTML: toast messages carry user-entered text.
  const TOAST_ICONS = { success: 'success', error: 'error', info: 'info', warning: 'warning' };
  if (window.LWIcons) {
    window.LWIcons.setLabel(toast, TOAST_ICONS[type] || 'info', message, { size: 'sm' });
  } else {
    toast.textContent = message;
  }
  document.body.appendChild(toast);

  // Trigger animation then auto-remove
  requestAnimationFrame(() => toast.classList.add('toast--visible'));
  setTimeout(() => {
    toast.classList.remove('toast--visible');
    toast.addEventListener('transitionend', () => toast.remove(), { once: true });
  }, 3000);
}


/* ── LOCKED / INVALID INTERACTION FEEDBACK ──────────────────────────
 * "Interactive Locked-State Feedback" — call this on click for any
 * element the learner CAN click but that can't actually be acted on
 * right now (a locked chapter row, a locked/pending dictionary chip,
 * any other locked/unavailable-content surface). Toggles the shared
 * .lw-shake-invalid class (css/style.css §19) on and back off via
 * 'animationend' — removing it first and forcing a reflow before
 * re-adding means a fast repeat click restarts the animation instead
 * of doing nothing because the class was already present. Doesn't
 * navigate or perform any action itself — callers still need their
 * own preventDefault()/early-return; this only supplies the feedback.
 */
function triggerLockedFeedback(el) {
  if (!el) return;
  el.classList.remove('lw-shake-invalid');
  void el.offsetWidth; // force reflow so the animation restarts on a repeat click
  el.classList.add('lw-shake-invalid');
  el.addEventListener('animationend', () => {
    el.classList.remove('lw-shake-invalid');
  }, { once: true });
}


/* ── NAVBAR / USER DETAILS: fill in placeholders from the session ──
 * Any element with [data-user-name], [data-user-email],
 * [data-user-level], or [data-user-joined] gets its text filled in.
 * Any element with [data-logout="relative/path/to/index.html"]
 * gets wired to call LWAuth.logout() instead of needing an href.
 * Used by the navbar greeting on every page and the "Your Account"
 * card on the dashboard.
 */
function initUserDetails() {
  const user = getActiveUser();

  document.querySelectorAll('[data-user-name]').forEach(el => { el.textContent = user.name; });
  document.querySelectorAll('[data-user-email]').forEach(el => { el.textContent = user.email; });
  document.querySelectorAll('[data-user-joined]').forEach(el => { el.textContent = user.joined || '—'; });
  document.querySelectorAll('[data-user-initial]').forEach(el => { el.textContent = (user.name || '?').charAt(0).toUpperCase(); });

  document.querySelectorAll('[data-logout]').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      window.LWAuth?.logout(btn.dataset.logout);
    });
  });
}


/* ── INIT ────────────────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', () => {
  initActiveNav();
  initSidebarNavGuard();
  initProgressBars();
  initUserDetails();
  // FIX (migration-analysis pass) — guarded null check added since
  // this now also runs on LinguaWave pages, several of which have
  // no <footer class="footer"> element at all; querySelector() would
  // otherwise throw here and silently abort whatever ran after it.
  const footerP = document.querySelector('.footer p');
  if (footerP) footerP.textContent = `LinguaWave · Capstone Project 2026`; // makes the footer of all pages relative to this text
});


/* ── EXPORTS (for use by page-specific JS files) ─────────────────── */
window.LinguaWave = {
  getActiveUser,
  showToast,
  triggerLockedFeedback,
};
</file>

<file path="pages/camera-practice.html">
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- NEW: sets data-theme before any CSS loads, so the page never
       flashes the wrong theme on load. Must stay first in <head>. -->
  <script>
    (function () {
      var pref = localStorage.getItem('lw-theme') || 'system';
      var resolved = pref === 'system'
        ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
        : pref;
      var root = document.documentElement;
      root.setAttribute('data-theme', resolved);
      root.setAttribute('data-theme-pref', pref);
      root.style.colorScheme = resolved;
      // Paints the correct background INSTANTLY, without waiting on
      // css/style.css to finish loading/parsing — this is the part
      // that actually stops the white flash on reload/navigation.
      root.style.background = resolved === 'light' ? '#F8FAFC' : '#0F172A';
    })();
  </script>
  <!--
    pages/camera-practice.html — Sign Lesson Viewer + Live Camera Assessment
    ─────────────────────────────────────────────────────────────────
    PURPOSE  : Shows the learning content for one ASL sign AND provides
               a live camera panel for real-time gesture practice.
               After reviewing the sign, the user must click "Practice
               Check" and pass it (see PASS_THRESHOLD in
               js/camera-practice.js) to unlock "Continue to Next
               Sign" — see the completion overlay near the bottom of
               this file, and endAssessment()/continueToNext() in
               js/camera-practice.js for the gate itself.

    CAMERA TIPS: the Camera Tips card below the Practice Check is a step of
               the first-visit guided tour and is also shown as a "Got it"
               reminder after repeated missed attempts on the same sign
               (see the script tags at the end of <body>). The card itself
               is the only copy and stays where it is.

    CONNECTS : ← pages/learn.html  (lesson card click)
               ← pages/dashboard.html  (Continue button)
               → next lesson.html (on completion)

    URL PARAMS: ?level=basic&sign=A
    SCRIPTS   : js/camera-practice.js (type="module") orchestrates all detection modules.

    ══════════════════════════════════════════════════════════════════
    BUG FIXES IN THIS FILE (matches lesson.js bug log):
    ══════════════════════════════════════════════════════════════════

    BUG 1 FIX — Added <div id="classifier-warn"> below the detection
    panel. This is the non-blocking warning badge that lesson.js writes
    to when the TF.js model fails to load. Previously the error was
    written into the full-screen camera-status overlay, which covered
    the camera feed. Now it appears BELOW the camera, not on top of it.

    BUG 4 FIX — assessment-prompt-box and score-display start hidden
    (style="display:none") and are shown/hidden by lesson.js when
    assessment starts/ends. No change needed here — they were already
    hidden in HTML; the bug was that lesson.js never showed them.
    ─────────────────────────────────────────────────────────────────
  -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lesson | LinguaWave</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../css/style.css" />
  <link rel="stylesheet" href="../css/lesson.css" />
  <link rel="stylesheet" href="../css/lesson-camera.css" />
  <link rel="stylesheet" href="../css/toast.css" />
  <link rel="stylesheet" href="../css/tour.css" />

  <script type="module" src="../js/auth.js"></script>
  <!-- Shared icon system. Plain <script> (not a module) and NOT deferred:
       window.LWIcons must exist before any page script, inline script or
       module body runs, and before DOMContentLoaded hydrates any
       data-lw-icon="" markup below. See js/icons.js. -->
  <script src="../js/icons.js"></script>
  <script src="../js/theme.js" defer></script>
  <script>
  window.addEventListener('lwauth-ready', () => {
    LWAuth.requireAuth('../index.html');
  });
  </script>
  <!-- Role guard: admin -> admin pages only, learners -> out of admin pages. Keep synchronous, in <head>. -->
  <script src="../js/role-guard.js"></script>
</head>
<body data-tour="camera-practice">

  <!-- ── SKIP LINK (Design pass, 2026-08-23; retargeted 2026-08-26) ───
       PIVOT_CHECKLIST.md "Design pass — learn.html/lesson.html sidebar
       not yet matching dashboard": this page's own tab-order problem is
       arguably bigger than dashboard's navbar — #course-sidebar (below)
       is a full unit/category/sign outline, potentially dozens of
       links/buttons, and it sits BEFORE the actual lesson content in
       DOM order (see the "course player" comment on .course-layout
       below), so every keyboard user currently tabs through the whole
       outline before reaching the sign they're actually here for.
       Uses css/style.css's shared `.skip-link` (§16), not a page-local
       copy. Must stay the very first element in <body>.

       `id="lesson-content"`/`tabindex="-1"` lives on `.lesson-header`
       (the sign title block) below, so the skip link lands directly on
       the teaching content itself, past the sidebar. `#lesson-content`
       id isn't referenced anywhere else (checked: no CSS, no JS
       `getElementById`/`querySelector` call) so it's safe to leave in
       place. -->
  <a href="#lesson-content" class="skip-link">Skip to lesson content</a>

  <!-- ── NAVBAR ───────────────────────────────────────────────── -->
  <nav class="navbar">
    <div class="container navbar__inner">
      <a href="dashboard.html" class="navbar__logo">Lingua<span>Wave</span></a>
      <ul class="navbar__links">
        <!-- href set dynamically by js/camera-practice.js's updateLessonMeta()
             (id="btn-back-to-lessons") once it knows this sign's
             mission/category — points to this sign's own Mission
             Overview page (mission-overview.html?mission=…), the
             equivalent of what this link used to send back to on
             V1's learn.html. Falls back to learn.html below if JS
             hasn't run yet. -->
        <li><a href="learn.html" id="btn-back-to-lessons">← Back to lessons</a></li>
        <li><a href="dashboard.html">Dashboard</a></li>
        <li><a href="learn.html" class="active">Learn</a></li>
      </ul>
      <div class="navbar__user">
        <span><span aria-hidden="true" data-lw-icon="user" data-lw-icon-size="sm"></span> <span data-user-name>Learner</span></span>
        <button class="theme-switch" id="theme-toggle" type="button" role="switch"
                aria-checked="false" title="Switch to dark theme" aria-label="Switch to dark theme">
          <span class="theme-switch__check">
            <span data-lw-icon="theme_sun" data-lw-icon-self="1" data-lw-icon-class="theme-switch__icon theme-switch__icon--sun"></span>
            <span data-lw-icon="theme_moon" data-lw-icon-self="1" data-lw-icon-class="theme-switch__icon theme-switch__icon--moon"></span>
          </span>
        </button>
        <a href="#" class="btn btn--ghost btn--sm" data-logout="../index.html">Log out</a>
      </div>
    </div>
  </nav>

  <!-- ── MAIN LESSON + CAMERA LAYOUT ──────────────────────────── -->
  <!-- NEW — "course player" merge: lesson.html is the single merged
       page a learner stays on for the whole teach->practice loop
       instead of bouncing back to learn.html between signs.
       #course-sidebar is populated by js/camera-practice.js's
       renderCourseSidebar() — see css/lesson.css's matching comment
       block for the full reasoning. The old lesson-progress strip
       (back-to-lessons link / sign counter / progress bar / level
       badge) and the mode-bar banner above were removed from this
      -owned copy per explicit request — js/camera-practice.js's
       getElementById() calls for those ids (#btn-back-to-lessons,
       #lesson-counter, #lesson-progress-fill, #lesson-strip-badge,
       #mode-bar) are all already null-guarded, so this needed no JS
       changes. Navigating out (Dashboard/Learn in the navbar above,
       or a different sign in #course-sidebar) is still how a learner
       leaves this sign. -->
  <section class="section section--sm">
    <div class="container container--wide">
      <div class="course-layout">
        <!-- Design pass, 2026-08-23: static loading placeholder (same
             gap #3 as learn.html's #lesson-grid) — js/camera-practice.js's
             renderCourseSidebar() replaces this aside's innerHTML
             wholesale on its first call, so this is naturally
             overwritten and needs no cleanup code. Uses
             css/style.css's shared `.loading-pulse` (§16). -->
        <aside class="course-sidebar" id="course-sidebar" aria-label="Course outline">
          <p class="text-muted loading-pulse" style="padding: var(--space-3);">Loading course outline…</p>
        </aside>
      <!-- `id="lesson-content"`/`tabindex="-1"` moved down onto
           .lesson-header below (2026-08-26) — see the skip-link comment
           at the top of <body> for why. -->
      <div class="lesson-layout">

        <!-- ══════════════════════════════════════════════════════
             LEFT PANEL — Reference lesson content
             ══════════════════════════════════════════════════════ -->
        <div class="lesson-content-panel">

          <!-- Sign header. `id="lesson-content"`/`tabindex="-1"` = skip-
               link target (see the skip-link comment at the top of
               <body>). -->
          <div class="lesson-header" id="lesson-content" tabindex="-1">
            <div class="lesson-letter" id="lesson-letter">A</div>
            <div>
              <h1 id="lesson-title">Letter A</h1>
              <p class="text-muted" id="lesson-subtitle">ASL Alphabet</p>
            </div>
          </div>

          <!-- Video demonstration -->
          <div class="lesson-video-wrap mt-8">
            <h2 class="heading-md">Watch the Sign in Motion</h2>
            <div class="lesson-video mt-4">
              <!--
                Demo video — TWO players live here, and js/camera-practice.js
                shows exactly one of them per sign, based on that sign's
                `videoUrl` in js/data.js (applyLessonVideo()):

                  • videoUrl is a YouTube embed URL
                      (https://www.youtube.com/embed/<id>?si=...)
                      → the <iframe id="lesson-video-embed"> below is shown
                        and its src is built from videoUrl, plus autoplay / muted /
                        loop / no controls / no related-video suggestions
                        (buildYouTubeSrc()). Clicking the video reveals controls.
                  • videoUrl is anything else (e.g. ../assets/videos/basic/B.mp4)
                      → the <video id="lesson-video"> is shown instead.

                Do NOT hardcode a YouTube URL in this file — change the
                sign's `videoUrl` in data.js and this page follows it.
              -->
              <video
                id="lesson-video"
                autoplay
                loop
                muted
                playsinline
                poster="../assets/images/placeholder-poster.png"
              >
                <source src="../assets/videos/placeholder.mp4" type="video/mp4" />
                Your browser does not support the video tag.
              </video>
              <!-- src stays about:blank until camera-practice.js fills it from data.js `videoUrl`. -->
              <iframe
                id="lesson-video-embed"
                width="560" height="315"
                src="about:blank"
                title="Sign demonstration video"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                hidden
              ></iframe>
              <!--
                Transparent click-catcher over the YouTube iframe (shown only for YouTube signs).
                The embed starts clean — muted, looping, NO controls / title / "More videos"
                (see buildYouTubeSrc() in camera-practice.js). A click anywhere on the video hits
                this button instead, which reloads the embed WITH YouTube's controls (seek, speed
                via the gear, fullscreen) and then removes itself so later clicks reach the player.
              -->
              <button
                type="button"
                id="lesson-video-shield"
                class="lesson-video__shield"
                aria-label="Show video controls"
                hidden
              ></button>
            </div>
            <p class="alert alert--info lesson-video-tip mt-4">
              <span aria-hidden="true" data-lw-icon="camera_tips" data-lw-icon-size="sm"></span> Watch the movement once, then try to remember it before replaying.
            </p>
          </div>

          <!-- Text explanation -->
          <div class="lesson-desc card mt-8" id="lesson-desc">
            <h2 class="heading-md">How to perform the sign</h2>
            <p class="mt-4" id="lesson-description">
              Make a fist with your thumb resting against the side of your
              index finger, not tucked underneath. Hold your hand upright
              with your palm facing the person you're signing to.
            </p>
            <ol class="lesson-desc__tips mt-4" id="lesson-tips">
              <li>Close all fingers into a firm fist</li>
              <li>Rest your thumb against the side of your index finger</li>
              <li>Keep your wrist straight and hand relaxed</li>
            </ol>
            <!-- NEW: populated by lesson.js from signData.referenceUrl -->
            <p class="mt-4 text-muted" id="lesson-reference-link" style="display:none;"></p>
          </div>

          <!-- PREV / NEXT navigation -->
          <div class="lesson-nav mt-8">
            <button class="btn btn--ghost" id="btn-prev">← Previous</button>
            <button class="btn btn--primary btn--lg" id="btn-next">Next Sign →</button>
          </div>

        </div><!-- /lesson-content-panel -->


        <!-- ══════════════════════════════════════════════════════
             RIGHT PANEL — Live camera + detection
             ══════════════════════════════════════════════════════ -->
        <div class="camera-panel">

          <!-- Camera header -->
          <div class="camera-panel__header">
            <h2>Live Camera</h2>
            <div class="hand-status-pill hand-status-pill--none" id="hand-status-pill">No hand detected</div>
          </div>

          <!-- Camera viewport -->
          <div class="camera-viewport">
            <!--
              BUG 1+2 NOTE: #camera-status is the FULL-SCREEN overlay used
              only during boot (loading / hard camera error states).
              lesson.js hides it (display:none) as soon as the camera is live
              by calling setStatus('', 'ready').
              DO NOT use this element for post-boot notifications — they will
              cover the camera feed. Use #classifier-warn below instead.
            -->
            <div class="camera-status camera-status--loading" id="camera-status">
              ⏳ Starting camera…
            </div>
            
            <!--
            BUG 7 FIX: Non-blocking face-tracking warning zone.
            lesson.js writes here (via setFaceWarn()) whenever the whole head
            isn't visible in frame — detection now needs face-relative landmarks
            (chin/forehead) for every sign, not just face-location signs like
            MOM/DAD, so this can show up during any lesson.
            -->
            <div
              id="face-warn"
              style="display:none; margin-top: 8px; padding: 10px 14px;
                    background: rgba(240,171,25,0.10); border: 1px solid rgba(240,171,25,0.3);
                    border-radius: 8px; font-size: 0.8rem; color: var(--clr-yellow,#f0ab19);
                    line-height: 1.4;"
            ></div>

            <!-- Live webcam feed -->
            <video
              id="lw-webcam"
              autoplay
              playsinline
              muted
              aria-label="Live webcam feed for sign detection"
            ></video>
            <!-- Skeleton overlay -->
            <canvas id="lw-canvas" aria-hidden="true"></canvas>
          </div><!-- /camera-viewport -->

          <!-- Detection readout + log — merged into one card. These
               used to be two separate cards; the log now lives inside
               the same panel as the live readout since they're really
               one feature (see current + history of the same thing). -->
          <div class="detection-panel card mt-4">
            <div class="detection-row">
              <span class="detection-label">Detected sign</span>
              <span class="detection-value" id="detected-sign">–</span>
            </div>
            <div class="confidence-wrap mt-3">
              <div class="confidence-track">
                <div class="confidence-bar-fill" id="confidence-bar-fill"></div>
              </div>
              <span class="confidence-text" id="confidence-text">0%</span>
            </div>

            <!--
              Motion buffer (shown for motion signs only). CHANGED:
              the standalone "Start Recording" button is gone, folded
              into "Start Assessment" — but detection also needs to
              work in plain practice mode (browsing a sign before
              taking the assessment), not only during a scored
              attempt. So this compact "Try it" trigger is back for
              PRACTICE mode specifically (lesson.js hides it once
              assessment mode starts, since that auto-triggers its own
              countdown per prompt — see showNextPrompt()). Two
              triggers that both call the same startMotionRecording()
              function isn't duplication, it's the same action exposed
              in two contexts: casual practice vs. a scored attempt.
            -->
            <div class="motion-buffer-wrap mt-3" id="motion-buffer-wrap">
              <div class="motion-buffer-wrap__head">
                <span class="detection-label" id="motion-status-label">Collecting frames</span>
                <button class="motion-try-btn" id="btn-try-practice" type="button"><span aria-hidden="true" data-lw-icon="current" data-lw-icon-size="sm"></span> Try it</button>
              </div>
              <div class="confidence-track">
                <div class="confidence-bar-fill confidence-bar-fill--motion" id="motion-buffer-bar"></div>
              </div>
            </div>

            <!-- Detection log — persistent, scrollable history of every
                 classification result, newest first. The live readout
                 above updates every frame and can change/vanish in well
                 under a second, especially for motion signs mid-
                 confirmation, so this keeps a running record. -->
            <div class="detection-log-inline mt-4">
              <div class="detection-log__header">
                <span class="detection-label">Detection log</span>
                <button class="detection-log__clear" id="btn-clear-log" type="button">Clear</button>
              </div>
              <ul class="detection-log__list" id="detection-log-list">
                <li class="detection-log__empty">No detections yet</li>
              </ul>
            </div>
          </div><!-- /detection-panel -->

          <!--
            BUG 1 FIX: Non-blocking classifier warning zone.
            lesson.js writes here (via setClassifierWarn()) when the TF.js
            model fails to load (Keras 3 / DTypePolicy export incompatibility).
            This sits BELOW the camera, not on top of it, so the camera feed
            is always visible regardless of model load state.
            Hidden by default; shown only when there is a warning to display.
          -->
          <div
            id="classifier-warn"
            style="display:none; margin-top: 8px; padding: 10px 14px;
                   background: var(--clr-red-soft); border: 1px solid var(--clr-red-soft);
                   border-radius: 8px; font-size: 0.8rem; color: var(--clr-red);
                   line-height: 1.4;"
          ></div>

          <!-- Assessment section — the Camera Practice check. GATE
               (this session): passing it is required to unlock
               "Continue to Next Sign" on the completion overlay below
               — see endAssessment()/continueToNext() in
               js/camera-practice.js. CHANGED: this button used to be
               "Practice Check", separate from a "Start Recording"
               button in the detection panel above. They did the same
               job (both meant "attempt this sign for real"), so
               they're merged — clicking this now also runs the 3-2-1
               countdown + recording automatically for motion signs
               once the get-ready pause ends (see showNextPrompt() in
               lesson.js). -->
          <div class="assessment-panel mt-4">

            <!-- Start button — triggers get-ready, then (for motion
                 signs) the 3-2-1 countdown and recording automatically. -->
            <button class="btn btn--secondary btn--full btn--lg" id="btn-start-assessment">
              <span aria-hidden="true" data-lw-icon="camera" data-lw-icon-size="sm"></span> Practice Check
            </button>

            <!-- MOVED (was above the button): this note now sits directly
                 under "Practice Check". It auto-hides whenever the button
                 itself is hidden (during a check, or on the name drill) —
                 see the sibling rule in css/lesson-camera.css. -->
            <p class="text-muted practice-check-note" style="font-size: var(--fs-xs);">
              You need at least 80% to move on. Webcam sign detection has real
              accuracy limits, so if it's not registering, check the Camera Tips
              below, then try again — "Practice & Retry" keeps you on this sign
              for another attempt.
            </p>

            <!-- Assessment prompt (shown during assessment only) -->
            <!-- BUG 4 NOTE: starts hidden; lesson.js sets display:'' in startAssessment() -->
