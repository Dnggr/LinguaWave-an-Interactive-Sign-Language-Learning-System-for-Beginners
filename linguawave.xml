/*
 * dashboard.css — Dashboard Page Styles
 * CONNECTS : pages/dashboard.html
 */

/* ── Skip link (Priority 2 §13, 2026-08-22 session) ──────────────────
   PIVOT_CHECKLIST.md §13 ("Ensure keyboard navigation reaches
   'Continue' first"). The Continue Learning button was already the
   first focusable element in this PAGE's own content (right after the
   header, per Priority 0 #1's placement) — but every keyboard user
   still has to tab through the full navbar (logo, 2 nav links, theme
   toggle, "Log out") first. Standard skip-link pattern: hidden
   off-screen until it receives keyboard focus, then jumps straight to
   `#continue-cta` (the SAME [data-continue-learning] anchor — see
   pages/dashboard.html, no new element). Page-scoped on purpose, same
   reasoning as `.section--tight` below: dashboard.css only loads on
   pages/dashboard.html, so this class can't leak onto or conflict with
   any other page even though the selector itself isn't page-prefixed. */
.skip-link {
  position: absolute;
  top: -100px;
  left: var(--space-4);
  z-index: 1000;
  background: var(--clr-accent);
  color: var(--clr-text-invert);
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-md);
  font-size: var(--fs-sm);
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
  transition: top var(--dur-fast) var(--ease);
}
.skip-link:focus {
  top: var(--space-4);
}

.dash-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-6);
  flex-wrap: wrap;
}

/* ── First-viewport layout (Dashboard UX Review Priority 1 §9,
   2026-08-21 code session) ──────────────────────────────────────────
   PIVOT_CHECKLIST.md's own review screenshot was already scrolled past
   "Overall Progress" by default — six stacked `.section--sm` blocks
   (header, hero, overall progress, account, recap, review), each
   paying var(--space-8)=32px of padding on BOTH top and bottom, push
   the primary action + progress summary below the fold on common
   screen heights before any content height is even counted.

   dashboard.css is only <link>ed from pages/dashboard.html, so both
   rules below are page-scoped by construction — they cannot affect
   learn.html/lesson.html/quiz.html/feedback.html, which don't load
   this file, even though `.section--sm` is a shared class name defined
   in css/style.css. No selector rename, no shared-file edit. */
.section--sm { padding-block: var(--space-6); }
/* Applied (see pages/dashboard.html) only to the 3 sections that must
   fit in the first viewport: page header, Continue Learning hero card,
   Overall Progress. Wins over .section--sm above at equal specificity
   because it's declared later in this same file. */
.section--tight { padding-block: var(--space-4); }

/* ── Loading / error / fallback states (Priority 2 §15, 2026-08-22
   session) ────────────────────────────────────────────────────────────
   PIVOT_CHECKLIST.md §15 ("Error/loading states"). See js/dashboard.js's
   file-header §15 paragraph for the full story (including a real,
   Playwright-verified hang bug in js/engine/progress.js's hydration this
   item's verification surfaced — not fixed there, that file is out of
   scope; this page's DOMContentLoaded handler now works around it with
   a bounded timeout instead).

   CLEANUP (this revision) — removed the .dash-loading-pulse rule
   (+ its @keyframes dash-pulse) that used to live here, along with the
   .dash-fallback-alert rule further down this section and the whole
   .dash-hero-row/.dash-progress-card* /.dash-progress-ring* family
   later in this file. Confirmed via a project-wide search across every
   pages/*.html and js/*.js file: none of these classes are applied
   anywhere in the live app — an earlier dashboard-rebuild session (see
   AI_MEMORY.md's 09-16 "Dashboard rebuild" row) wrote this CSS, but the
   matching HTML/JS wiring either never landed in this repo or was
   reverted afterward without the CSS being cleaned up. The real, live
   loading/error affordances on this page are .unit-progress-list__loading
   (below) and the shared .alert/.alert--error component from
   css/style.css. */

/* Matches unit-progress-row's own internal padding so the loading
   placeholder (pages/dashboard.html) sits at the same inset as the real
   rows that replace it, instead of looking like a smaller, misaligned
   flash of content right before the real list renders. */
.unit-progress-list__loading {
  padding: var(--space-3) var(--space-4);
  margin: 0;
}

/* ── Continue Learning hero card (2026-08-21 code session) ───────────
   PIVOT_CHECKLIST.md Dashboard UX Review Checklist → Priority 0 #1
   ("Make 'Continue Learning' the primary action"). Deliberately the
   most visually weighted card on the page — accented border by
   default (not just on :hover like the generic `.card`), a soft
   gradient wash, and a bigger icon — since the checklist's own rule
   is that this card should read as "this is what you do next," not
   another status tile competing with the aggregate progress card
   below it. See js/dashboard.js's renderContinueCard(). Untouched by
   the Priority 0 #2 pass below — #2 demotes the OTHER card instead of
   further inflating this one. */
.continue-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  flex-wrap: wrap;
  border-color: var(--clr-accent);
  background: linear-gradient(135deg, var(--clr-accent-soft), transparent 60%);
}
.continue-card__main {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  min-width: 0;
}
.continue-card__icon {
  flex: 0 0 auto;
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-2xl);
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-pill);
}
.continue-card__text {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}
/* EYEBROW PASS: sentence case, no tracking (was UPPERCASE + letter-spacing) */
.continue-card__eyebrow {
  font-size: var(--fs-sm);
  letter-spacing: 0;
  color: var(--clr-text-muted);
  font-weight: 600;
}
.continue-card__title {
  font-family: var(--font-display);
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--clr-text);
  /* Long "{category} → {sign}" strings (e.g. long phrase titles)
     shouldn't force the actions column off-screen on narrow desktop
     widths — wrap instead of overflowing. */
  overflow-wrap: anywhere;
}
.continue-card__progress {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-top: var(--space-2);
}
.continue-card__progress .progress-bar {
  width: 140px;
  flex: 0 0 auto;
}
.continue-card__progress-label {
  font-size: var(--fs-xs);
  color: var(--clr-text-muted);
  white-space: nowrap;
}
.continue-card__actions {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex: 0 0 auto;
}

@media (max-width: 640px) {
  .continue-card { flex-direction: column; align-items: stretch; }
  .continue-card__actions { flex-direction: column; align-items: stretch; }
  .continue-card__actions .btn { width: 100%; }
  .continue-card__progress { flex-wrap: wrap; }
  .continue-card__progress .progress-bar { width: 100%; flex: 1 1 100%; }
}

/* ── Overall Progress heading: demoted (Priority 0 #2, 2026-08-21) ───
   Applied to the "Overall Progress" <h2> in pages/dashboard.html —
   every other dashboard heading (Your Account, Signs You've Learned)
   is unchanged. Shrinks it from the default bold display-font h2 down
   to a small uppercase label, so it reads as a section of supporting
   detail under the Continue Learning hero card rather than a second
   headline competing with it. Purely typographic — no underlying
   markup/heading level changed (still an <h2>, so document outline /
   accessibility tree is unaffected).

   UPDATED (Priority 1 §10, this session): the new "Learning Path"
   heading added above the unit-progress-list also uses this class —
   it's a sibling summary block in the same secondary tier as Overall
   Progress, not a new headline of its own weight. Still just these
   two headings; "Your Account" and "Signs You've Learned" remain
   unchanged, same as the note above already said. */
.dash-heading--secondary {
  font-size: var(--fs-base);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .04em;
  color: var(--clr-text-muted);
}

/* ── Progress card: colored top edge (CSS-only) ─────────────────────
   REV 4 PHASE 4: there's only one progress-card now (the aggregate
   "Your ASL Path" card) — the old per-tier `[data-level-card]`
   attribute selectors are gone along with the three-card grid they
   styled. One generic accent-colored edge instead of three
   level-colored ones. */
.progress-card {
  position: relative;
  overflow: hidden;
}
/* REMOVED (light-mode UX pass) — the 3px accent stripe (.progress-card::before)
   was clipped by the card's rounded corners, so it read as a stray line
   across the top rather than an intentional edge, and "colored stripe on
   one edge of a card" is a generic-dashboard tell. The ring + eyebrow
   already carry the accent. */

.progress-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.progress-card__pct {
  font-family: var(--font-display);
  font-size: var(--fs-2xl);
  font-weight: 700;
  color: var(--clr-text);
  font-variant-numeric: tabular-nums;
}
.progress-card__label {
  font-size: var(--fs-sm);
  color: var(--clr-text-muted);
  margin-top: var(--space-1);
}
.progress-card--locked .progress-card__pct { color: var(--clr-text-muted); }

/* Progress bar fill gets a subtle gradient instead of a flat block —
   small touch, but flat single-tone bars are the most "generic admin
   dashboard" tell there is. */
.progress-card .progress-bar__fill {
  /* CHANGED (Impeccable pass): the fill is now full width and slid by
     transform (css/style.css), so the gradient is sized to the visible p%
     and pinned to the right edge instead of being stretched across the
     hidden part. */
  background: linear-gradient(90deg, var(--clr-accent-dim), var(--clr-accent)) right / calc(var(--p, 0) * 1%) 100% no-repeat;
}

/* ── Progress card: secondary/demoted variant (Priority 0 #2,
   2026-08-21) ────────────────────────────────────────────────────────
   PIVOT_CHECKLIST.md Dashboard UX Review Checklist → Priority 0 item
   #2 ("Replace the dashboard's current 'report' feeling" /
   "Keep overall progress, but make it secondary to the next action").

   Before this pass, this card matched the Continue Learning hero
   card's visual weight almost 1:1 — same accent-colored top edge,
   same big display-font number, plus a colored badge pill. That's
   exactly the "equal visual weight" problem the checklist names.
   Toned down here: thinner NEUTRAL top edge (not accent-colored — the
   hero card above already owns that treatment), a smaller percentage
   figure, and a muted/neutral badge instead of an accent-colored one.

   Deliberately does NOT touch:
     - `data-overall-pct` / `data-overall-count` / `data-overall-status`
       text content — js/dashboard.js's renderOverallProgress() output
       is byte-for-byte unchanged. Relabeling what the number MEANS
       (vs. mastery) is Priority 0 item #3, a separate, still-open
       item — this class only changes presentation.
     - `.progress-bar__fill`'s gradient (kept, it's a small enough
       detail that it doesn't compete with the hero card).
     - Card padding/spacing (kept `.card`'s default — resizing text and
       neutralizing color already achieves the demotion without
       touching layout other rules may depend on). */
.progress-card--secondary::before {
  background: var(--clr-border);
  height: 2px;
}
.progress-card--secondary .progress-card__pct {
  font-size: var(--fs-lg);
}
.progress-card--secondary .badge {
  background: var(--clr-surface-2);
  color: var(--clr-text-muted);
  border: 1px solid var(--clr-border);
}
/* Priority 1 §9: the card's own padding was still .card's default 32px
   on every side — shrunk it now that the badge/pct/label are already
   smaller (Priority 0 #2/#3), so the card's footprint matches its
   reduced visual weight instead of just having smaller text inside a
   full-size box. Only affects this card, not the hero card above it
   (.continue-card is deliberately untouched — see its own comment). */
.progress-card--secondary { padding: var(--space-4); }

/* ── Progress Snapshot — 4-tile stat strip (Priority 2 §11, 2026-08-22
   session) ────────────────────────────────────────────────────────────
   PIVOT_CHECKLIST.md §11 ("Add learning statistics that actually
   motivate"), MVP subset (Practice Progress / Assessments Passed /
   Signs Practiced / Current Unit — the checklist's own "only add the
   first four" instruction; streak/review-due/best-score are explicitly
   deferred). See js/dashboard.js's renderStatsSnapshot() for the data
   side and its own doc comment for why this deliberately overlaps with
   the Overall Progress card and Your Account's Current Unit field.

   auto-fit + minmax reflows from 4 columns down to 1 with no extra
   media query needed. Incidentally already covers PIVOT_CHECKLIST.md
   §14's ~900px/mobile checks for THIS block specifically — §14 itself,
   for the rest of the page, is still open/untested.

   Kept lighter than `.card` (no shadow, no hover accent) so four tiles
   in a row don't outweigh the single Continue Learning hero card above
   them — same "don't compete with the hero card" instinct already
   applied to `.progress-card--secondary`. */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: var(--space-4);
}
.stat-tile {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  padding: var(--space-3) var(--space-4);
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
}
.stat-tile__value {
  font-family: var(--font-display);
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--clr-text);
  font-variant-numeric: tabular-nums;
}
/* "Current Unit" is a name, not a number — tabular-nums/xl sizing would
   either do nothing useful or risk overflow on a "Unit 3 · Everyday
   Essentials"-length string. Smaller, no tabular-nums, and wraps
   instead of pushing the tile wider than its grid track. */
.stat-tile__value--text {
  font-size: var(--fs-base);
  font-variant-numeric: normal;
  overflow-wrap: anywhere;
}
.stat-tile__label {
  font-size: var(--fs-xs);
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--clr-text-muted);
}

/* ── Unit progress list — compact learning-path summary (Priority 1) ──
   Still secondary to the Continue Learning card. This is a summary of the
   existing flat trail, NOT a second trail/navigation surface.

   RESTYLED (Priority 1 §9, 2026-08-21): PIVOT_CHECKLIST.md's item #9
   explicitly flags "avoid making every unit row look like a large
   standalone card" — before this pass each row had its own border +
   background + border-radius + a gap between rows, i.e. N separate
   mini-cards stacked with air between them. Restyled into ONE bordered
   list container (this rule) with thin border-bottom row separators
   instead — no HTML or JS change: js/dashboard.js's unitRowHtml() still
   emits the exact same `unit-progress-row`/`--current`/`--done`/
   `--locked` class names, only what those classes paint changed.
   Current/done state now reads via a left accent border + tinted
   background instead of a full box border, so rows stay visually
   distinct without each one reading as its own card. */
.unit-progress-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--clr-surface);
}
/* ── Unit groups (collapsible sections by level) ─────────────────────
   BUG FIX (this pass): the Learning Path is 71 units rendered flat —
   the literal "dashboard is so long" complaint. Grouped into 3 native
   <details> sections (Alphabet & Numbers / Words & Topics / Phrases &
   Conversations — js/dashboard.js's getUnitLevel() derives this from
   the `level` data.js already assigns each category) inside the same
   bordered .unit-progress-list container, so closed sections cost
   nothing to scroll past. Mirrors the same fix in css/learn.css's
   .trail-group for the main Learn page. */
.unit-progress-group { border-bottom: 1px solid var(--clr-border); }
.unit-progress-group:last-child { border-bottom: none; }
.unit-progress-group__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding: var(--space-4);
  cursor: pointer;
  list-style: none;
  user-select: none;
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--fs-base);
  transition: background var(--dur-fast) var(--ease);
}
.unit-progress-group__summary::-webkit-details-marker { display: none; }
.unit-progress-group__summary::before {
  content: '▸';
  display: inline-block;
  margin-right: var(--space-3);
  color: var(--clr-text-muted);
  transition: transform var(--dur-base) var(--ease);
}
.unit-progress-group[open] > .unit-progress-group__summary::before { transform: rotate(90deg); }
.unit-progress-group__summary:hover { background: var(--clr-surface-2); }
.unit-progress-group__summary:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--clr-accent); }
.unit-progress-group__label { flex: 1; }
.unit-progress-group__meta {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: var(--fs-xs);
  color: var(--clr-text-muted);
  background: var(--clr-surface-2);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-pill);
  white-space: nowrap;
}
.unit-progress-group__rows { display: flex; flex-direction: column; }
.unit-progress-row {
  display: flex;
  align-items: flex-start;
  gap: var(--space-4);
  padding: var(--space-3) var(--space-4);
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--clr-border);
  border-left: 3px solid transparent;
  border-radius: 0;
  text-decoration: none;
  color: var(--clr-text);
}
.unit-progress-row:last-child { border-bottom: none; }
a.unit-progress-row:hover {
  background: var(--clr-surface-2);
  text-decoration: none;
}
/* NEW (Priority 2 §13, 2026-08-22) — "Ensure interactive unit rows
   have visible focus states." Before this, keyboard focus on a row
   fell back to the browser's default outline — functional, but this
   list sits inside .unit-progress-list's `overflow: hidden` (needed to
   clip square row corners to the container's rounded ones), which can
   visually clip a default OUTER outline ring on the first/last row. An
   INSET box-shadow can't be clipped by the container the same way (it
   never extends past the row's own border box), so it's used here
   instead of `outline` — same "outline:none + box-shadow ring"
   substitution css/style.css's own `.form-input:focus` already uses,
   just inset instead of a soft outer glow since this is a full-width
   list row, not a small form field with room around it. `:focus-visible`
   (not `:focus`) so a mouse click doesn't show a ring meant for
   keyboard users only. Scoped to unit rows only, per this item's
   literal wording — other buttons on this page (`.btn`) already show
   the browser's default focus outline (nothing in css/style.css
   removes it for `.btn`), left alone. */
a.unit-progress-row:focus-visible {
  outline: none;
  box-shadow: inset 0 0 0 2px var(--clr-accent);
}
.unit-progress-row--locked { opacity: .52; }
.unit-progress-row--current {
  border-left-color: var(--clr-accent);
  background: var(--clr-accent-soft);
}
.unit-progress-row--done {
  border-left-color: var(--clr-success);
  background: var(--clr-success-soft);
}
.unit-progress-row__icon {
  flex: 0 0 auto;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--clr-accent-soft);
  border-radius: var(--radius-pill);
  font-size: var(--fs-base);
}
.unit-progress-row__body {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.unit-progress-row__head {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}
.unit-progress-row__title {
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--clr-text);
}
.unit-progress-row__current-badge,
.unit-progress-row__reference-badge,
.unit-progress-row__done-badge {
  display: inline-flex;
  align-items: center;
  padding: 2px var(--space-2);
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
  font-weight: 700;
  letter-spacing: .03em;
  white-space: nowrap;
}
.unit-progress-row__current-badge {
  background: var(--clr-accent);
  color: var(--clr-text-invert);
}
.unit-progress-row__reference-badge {
  background: var(--clr-surface-2);
  border: 1px solid var(--clr-border);
  color: var(--clr-text-muted);
}
/* NEW (Priority 2 §13, 2026-08-22) — "Current/locked/done state must
   not rely only on border color." A fully-done row previously had NO
   non-color signal at all — only the left border/background flipping
   to --clr-success. Same shared-base rule above, own color block here,
   same shape as the other two badges (see the Priority 1 §10 session
   log for why this "shared base + per-badge override" split is
   deliberate, not duplicated CSS). Rendered by unitRowHtml() in
   js/dashboard.js only when metrics.done is true. */
.unit-progress-row__done-badge {
  background: var(--clr-success-soft);
  border: 1px solid var(--clr-success);
  color: var(--clr-success);
}
.unit-progress-row__status {
  font-size: var(--fs-xs);
  color: var(--clr-text-muted);
}
/* PRIORITY 1 §5 (this session) — "Next: {category} → {sign}" line,
   shown only on the row carrying .unit-progress-row__current-badge.
   Accent-colored (not muted) so the specific lesson/sign reads as the
   answer to "what do I do next," not a secondary status caption. */
.unit-progress-row__current-detail {
  font-size: var(--fs-xs);
  font-weight: 600;
  color: var(--clr-accent);
}
.unit-progress-row__progress {
  display: grid;
  grid-template-columns: minmax(110px, 1fr) auto;
  align-items: center;
  gap: var(--space-3);
}
.unit-progress-row__progress .progress-bar {
  width: 100%;
  height: 5px;
}
.unit-progress-row__metric,
.unit-progress-row__assessment {
  font-size: var(--fs-xs);
  color: var(--clr-text-muted);
  white-space: nowrap;
}
.unit-progress-row__assessment { align-self: flex-start; }
.unit-progress-row--done .unit-progress-row__assessment { color: var(--clr-success); }
.unit-progress-row--current .unit-progress-row__assessment {
  color: var(--clr-text);
  font-weight: 600;
}
@media (max-width: 640px) {
  .unit-progress-row {
    gap: var(--space-3);
    padding: var(--space-3);
  }
  .unit-progress-row__progress {
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }
  .unit-progress-row__metric,
  .unit-progress-row__assessment {
    white-space: normal;
  }
}

/* ── RESTORED (this session) ──────────────────────────────────────
   The §4 Priority 1 patch deleted everything below this point (recap
   grid + account card) while rewriting the unit-progress-row block
   above — with no replacement rule for either selector family. Since
   pages/dashboard.html's #recap-grid and .account-card markup was
   never touched, both sections rendered completely unstyled (raw
   divs/spans) on any real page load. Restored unchanged from before
   that session — see this session's AI_MEMORY.md entry. */

/* ── Recap header (Priority 1 §7, 2026-08-21 code session) ─────────
   "N signs practiced" count next to the heading + a "recently
   practiced, not mastery" subtitle. Mirrors the existing
   .progress-card__head / .progress-card__label pattern above
   (flex head row + muted label line beneath) for visual consistency
   with the Overall Progress card rather than inventing a new layout
   idiom just for this section. */
.recap-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-3);
  flex-wrap: wrap;
}
.recap-head h2 { margin-bottom: 0; }
.recap-head__count {
  font-size: var(--fs-xs);
  color: var(--clr-text-muted);
  white-space: nowrap;
}
.recap-head__subtitle {
  font-size: var(--fs-sm);
  margin-top: var(--space-1);
  margin-bottom: var(--space-4);
}

/* Recap grid — chips, not squares */
.recap-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

/*
  BUG FIX: this used to be a fixed 56x56px square trying to fit
  whatever sign title was practiced — fine for a single letter, but
  multi-word entries like "I AM FINE" or "MY SISTER" wrapped inside a
  box sized for one character and visually overlapped/collided.
  Rebuilt as an auto-width pill: short signs (single letters) stay
  compact, phrases grow to fit, and anything genuinely too long
  truncates cleanly with an ellipsis + native tooltip instead of
  wrapping garbage.
*/
.recap-card {
  display: flex;
  align-items: center;
  gap: 0;
}
/*
  BUG FIX (Priority 2 §14, 2026-08-22 session): text-overflow:ellipsis
  was silently failing on long chip labels — verified in a real browser
  (headless Chromium via Playwright) with actual phrase-length signs
  (e.g. "WHERE IS THE HOSPITAL", "WHAT IS YOUR FAVORITE SUBJECT?").
  Long labels were clipped with NO "…" shown, and — because this rule
  was `display:flex; justify-content:center`, not a normal block —
  the clip point wasn't anchored to the end of the string: text got
  cut from whichever side had less room once centered, sometimes
  losing characters off the FRONT of the phrase instead of the end
  ("HIS IS AN EMERGENCY" instead of "THIS IS AN EMERGENCY…").
  `text-overflow: ellipsis` only works reliably on a normal block/
  inline-block box with `white-space: nowrap` — flexbox centering the
  overflowing element itself breaks the browser's overflow anchor.
  Fixed by switching to `display:block; text-align:center` (keeps the
  same visual centering for short labels) and `line-height` equal to
  the pill's content height (38px = 40px height − 2×1px border) to
  replace the vertical centering `align-items:center` used to provide,
  since single-line block text can't use flex alignment. Verified
  post-fix in the same real-browser harness: every truncated chip now
  shows a trailing "…" and reads from the start of the phrase. No
  other rule on this page uses this flex-center-with-ellipsis pattern
  (grepped `text-overflow` across css/*.css to confirm this is the
  only occurrence).
*/
.recap-card__img {
  min-width: 40px;
  height: 40px;
  line-height: 38px;
  max-width: 160px;
  padding: 0 var(--space-3);
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-pill);
  display: block;
  text-align: center;
  font-family: var(--font-display);
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--clr-text);
  letter-spacing: .02em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.recap-card:hover .recap-card__img {
  border-color: var(--clr-accent);
  color: var(--clr-accent);
}
.recap-card--locked {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 40px;
  height: 40px;
  padding: 0 var(--space-3);
  background: transparent;
  border: 1px dashed var(--clr-border);
  border-radius: var(--radius-pill);
  color: var(--clr-text-muted);
}

/* "View all" toggle (Priority 1 §7). Reuses .btn/.btn--ghost/.btn--sm
   as-is — no new button styling needed, just spacing above it. Hidden
   by default in the HTML; js/dashboard.js's renderRecap() only shows
   it once there are more than RECAP_COLLAPSED_LIMIT practiced signs. */
.recap-foot {
  margin-top: var(--space-4);
}

/* ── REVIEW entry point (Priority 1 §6, 2026-08-21; extended
   2026-08-22 per §17 "Recommended learning-site structure") ───────
   Deliberately a single lightweight card, not a second recap grid or
   a new trainer UI — see js/dashboard.js's renderReviewEntry() for
   why. [data-review-actions] now holds up to 3 small chip-style links
   (most recent first) instead of one button; .review-card__actions'
   flex-wrap/gap keeps them tidy at any width. Content (the links, or
   the disabled-style placeholder) is filled entirely by JS. */
.review-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  flex-wrap: wrap;
}
.review-card__body {
  color: var(--clr-text-muted);
  font-size: var(--fs-sm);
  max-width: 48ch;
}
.review-card__actions {
  flex-shrink: 0;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
/* Same "no href, no fake button" empty state unitRowHtml() uses for
   locked units, rendered here as a non-interactive <span> instead of
   a <button disabled> so it never gets tab-focus while doing nothing. */
.review-card__actions [aria-disabled="true"] {
  opacity: .45;
  cursor: not-allowed;
}
@media (max-width: 640px) {
  .review-card {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* ── YOUR ACCOUNT (user details card) ───────────────────────────── */
/* Priority 1 §9 (2026-08-21): checklist explicitly asks to "keep the
   account card compact." Card padding shrunk from .card's default 32px
   to 16px, avatar shrunk 64px → 44px (font size stepped down to match),
   and the gaps tightened. Content and every data-user-* hook are
   unchanged — sizing/spacing only. */
.account-card {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
  padding: var(--space-4);
}
.account-avatar {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--clr-accent), var(--clr-accent-dim));
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--clr-text-invert);
  box-shadow: var(--shadow-card);
}
.account-details {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.account-details__name {
  font-family: var(--font-display);
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--clr-text);
}
.account-details__email {
  font-size: var(--fs-sm);
  color: var(--clr-text-muted);
}
.account-meta {
  display: flex;
  gap: var(--space-4);
  margin-left: auto;
  flex-wrap: wrap;
}
.account-meta__item {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.account-meta__label {
  font-size: var(--fs-xs);
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--clr-text-muted);
}
.account-meta__value {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--clr-text);
}
/* ═════════════════════════════════════════════════════════════════
 * DASHBOARD REBUILD (blue-teal mockup alignment pass)
 * ─────────────────────────────────────────────────────────────────
 * Everything below is new, for the rebuilt pages/dashboard.html /
 * js/dashboard.js (greeting + mission banner + progress ring +
 * learning-path grid + recommended grid). Distinct class names on
 * purpose (.mission-banner, .progress-card, .path-tile, .rec-card)
 * so none of this collides with the older .hero-row/.continue-card/
 * .journey-rail/.journey-card rules above, which this rebuild no
 * longer uses but which are left in place rather than risk deleting
 * something still relied on elsewhere (this file has already been
 * through one V1→V2 pivot — see that section's own header comment —
 * and .stats-grid/.stat-tile from that era ARE still live, shared
 * with pages/progress.html). Colors/spacing/radii all come from the
 * shared tokens in css/style.css — no new hex values introduced.
 * ═════════════════════════════════════════════════════════════════ */

/* ── Greeting ──────────────────────────────────────────────────── */
.dash-greeting h1 {
  font-family: var(--font-display);
  font-size: var(--fs-2xl);
  font-weight: 700;
  color: var(--clr-text);
  display: flex;
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
}
.dash-greeting__wave {
  display: inline-block;
  animation: dash-wave 2.2s ease-in-out infinite;
  transform-origin: 70% 70%;
}
@keyframes dash-wave {
  0%, 60%, 100% { transform: rotate(0deg); }
  10% { transform: rotate(14deg); }
  20% { transform: rotate(-8deg); }
  30% { transform: rotate(14deg); }
  40% { transform: rotate(-4deg); }
}
@media (prefers-reduced-motion: reduce) {
  .dash-greeting__wave { animation: none; }
}

/* ── Section heading row ("Learning Path" / "Recommended for You") ─ */
.section-heading-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-4);
  margin-bottom: var(--space-4);
}
.section-heading-row h2 {
  font-family: var(--font-display);
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--clr-text);
}
.section-heading-row__link {
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--clr-accent);
  white-space: nowrap;
}
.section-heading-row__link:hover { text-decoration: underline; }

/* ── Today's Mission + Your Progress row ──────────────────────────
 * 2:1 split — the mission banner takes the wide column, the
 * progress card sits beside it, matching the mockup's proportions.
 * Stacks to one column below 900px. */
.dash-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
  gap: var(--space-6);
  align-items: stretch;
}
@media (max-width: 900px) {
  .dash-hero-grid { grid-template-columns: 1fr; }
}

/* ── Today's Mission banner ───────────────────────────────────────
 * Deliberately the ONE spot on this page that breaks from the flat
 * .card look — a gradient hero, same "this is the important thing
 * right now" treatment index.html's own hero section uses, so the
 * Dashboard reads as "start here" the instant it loads. */
.mission-banner {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-6);
  min-height: 220px;
  padding: var(--space-8);
  border-radius: var(--radius-xl);
  /* CHANGED (light-mode UX pass) — reads --banner-from/to (style.css)
     instead of --clr-accent/--clr-accent-dim. Light values are identical
     to before; dark no longer puts white text on light-blue #60A5FA. */
  background: linear-gradient(135deg, var(--banner-from) 0%, var(--banner-to) 100%);
  box-shadow: var(--shadow-card);
}
.mission-banner__text {
  position: relative;
  z-index: 1;
  max-width: 480px;
}
/* EYEBROW PASS: sentence case, no tracking (was UPPERCASE + letter-spacing) */
.mission-banner__eyebrow {
  font-size: var(--fs-sm);
  font-weight: 700;
  letter-spacing: 0;
  color: rgba(255, 255, 255, .95); /* CHANGED — was .85 = 4.20:1 on the light banner (AA needs 4.5) */
  margin-bottom: var(--space-2);
}
.mission-banner__title {
  font-family: var(--font-display);
  font-size: var(--fs-xl);
  font-weight: 700;
  color: #ffffff;
  margin-bottom: var(--space-2);
}
.mission-banner__desc {
  font-size: var(--fs-sm);
  color: rgba(255, 255, 255, .95); /* CHANGED — was .88 = 4.37:1 */
  margin-bottom: var(--space-5);
  line-height: 1.5;
}
.mission-banner__cta {
  background: #ffffff;
  color: var(--banner-to); /* CHANGED — was --clr-accent-dim, which is only 3.7:1 on white in dark mode */
}
.mission-banner__cta:hover { background: rgba(255, 255, 255, .9); }
.mission-banner__art {
  position: relative;
  z-index: 0;
  flex: 0 0 auto;
  width: 160px;
  height: 160px;
}
.mission-banner__art svg { width: 100%; height: 100%; }
@media (max-width: 640px) {
  .mission-banner { flex-direction: column; text-align: center; padding: var(--space-6); }
  .mission-banner__text { max-width: none; }
  .mission-banner__art { width: 110px; height: 110px; }
}

/* ── Your Progress card ───────────────────────────────────────────
 * Ring is a plain conic-gradient circle (same technique as
 * pages/progress.html's larger hero ring in css/app.css — kept as
 * its own smaller copy here since the two live in different
 * stylesheets and this one never needs to grow past card size). */
.progress-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: var(--space-5);
}
.progress-card__top {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}
.progress-ring {
  --pct: 0;
  flex: 0 0 auto;
  width: 84px;
  height: 84px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: conic-gradient(var(--clr-accent) calc(var(--pct) * 1%), var(--clr-track) 0); /* CHANGED — track was --clr-surface-2 (1.09:1) */
  transition: background 400ms var(--ease);
}
.progress-ring::before {
  content: '';
  position: absolute;
}
.progress-ring__pct {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--clr-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--clr-text);
}
.progress-card__level {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}
/* EYEBROW PASS: sentence case, no tracking (was UPPERCASE + letter-spacing) */
.progress-card__level-eyebrow {
  font-size: var(--fs-sm);
  font-weight: 700;
  letter-spacing: 0;
  color: var(--clr-accent);
}
.progress-card__level-title {
  font-size: var(--fs-base);
  font-weight: 700;
  color: var(--clr-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.progress-card__stats {
  display: flex;
  justify-content: space-between;
  gap: var(--space-3);
  padding-top: var(--space-4);
  border-top: 1px solid var(--clr-border);
}
.progress-card__stat {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}
.progress-card__stat-value {
  font-size: var(--fs-base);
  font-weight: 700;
  color: var(--clr-text);
  white-space: nowrap;
}
.progress-card__stat-label {
  font-size: var(--fs-xs);
  color: var(--clr-text-muted);
  white-space: nowrap;
}

/* ── Learning Path grid ───────────────────────────────────────────
 * Icon-tile grid — one tile per mission, same statusMeta() labels/
 * colors as pages/learn.html's rows so "In Progress"/"Locked"/
 * "Completed" mean the same thing everywhere in the app. */
.learning-path-grid {
  display: grid;
  /* CHANGED (light-mode UX pass) — min was 140px. Once the missing
     --space-5 padding was restored, a 140px tile only had ~100px inside,
     which wrapped the "In Progress" badge onto two lines. */
  grid-template-columns: repeat(auto-fill, minmax(156px, 1fr));
  gap: var(--space-4);
}
.path-tile .badge { white-space: nowrap; }
.path-tile {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
  padding: var(--space-5);
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  text-align: left;
  transition: transform var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
}
a.path-tile:hover {
  transform: translateY(-2px);
  border-color: var(--clr-accent);
}
.path-tile--locked {
  /* CHANGED (light-mode UX pass) — was `opacity: .6` on the whole tile,
     which also faded the Locked badge (2.29:1 -> lower). Now the tile
     recedes by losing its card surface and title weight instead, so the
     badge stays readable. */
  background: var(--clr-bg);
  box-shadow: none;
  cursor: not-allowed;
}
.path-tile--locked .path-tile__title { color: var(--clr-text-muted); }
.path-tile__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--clr-accent-soft);
  color: var(--clr-accent);
}
.path-tile--done .path-tile__icon { background: var(--clr-success-soft); color: var(--clr-success); }
.path-tile--current .path-tile__icon { background: var(--clr-orange-soft); color: var(--clr-orange); }
.path-tile--locked .path-tile__icon { background: var(--clr-locked-soft); color: var(--clr-locked); }
.path-tile__title {
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--clr-text);
}
.path-tile__count {
  font-size: var(--fs-xs);
  color: var(--clr-text-muted);
}
.path-tile__badge { margin-top: auto; }

/* ── Recommended for You grid ──────────────────────────────────── */
.recommended-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: var(--space-4);
}
.rec-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
}
.rec-card__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  margin-bottom: var(--space-1);
}
/* CHANGED (light-mode UX pass) — four different tints (teal/violet/
   orange/green) on four sibling cards that don't encode anything.
   style.css's own palette notes say violet is reserved for the
   "Mission mastered!" moment and that categories shouldn't each get a
   color, and orange/green already mean "in progress"/"done" on the
   path tiles right above. One accent tone; the --tone class names stay
   so js/dashboard.js needs no change. */
.rec-card__icon--teal,
.rec-card__icon--violet,
.rec-card__icon--orange,
.rec-card__icon--success { background: var(--clr-accent-soft); color: var(--clr-accent-text); }
.rec-card__title {
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--clr-text);
}
.rec-card__desc {
  font-size: var(--fs-xs);
  color: var(--clr-text-muted);
  line-height: 1.5;
  flex: 1;
}
.rec-card__cta { margin-top: var(--space-2); }
