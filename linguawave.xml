/* css/game.css — Wall Breaker. Standalone; only reads shared theme vars. */
.gm{position:relative;max-width:1100px;margin:0 auto;padding:var(--space-6)}
.gm-head{display:flex;justify-content:space-between;align-items:flex-end;gap:var(--space-4);flex-wrap:wrap;margin-bottom:var(--space-4)}
.gm-title{margin:0}
.gm-stats{display:flex;gap:var(--space-4);font-size:var(--fs-sm)}
.gm-stats b{font-size:var(--fs-lg)}
.gm-top{display:grid;grid-template-columns:1fr 240px;gap:var(--space-4)}
.gm-cam{position:relative;aspect-ratio:16/9;background:#000;border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--clr-border)}
.gm-cam video,.gm-cam canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;transform:scaleX(-1)}
.gm-cam__status{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:1rem;color:#fff;background:rgba(0,0,0,.35);font-size:var(--fs-sm)}
.gm-target{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);padding:6px 18px;border-radius:var(--radius-pill);background:rgba(15,23,42,.85);color:#fff;font-weight:700;font-size:var(--fs-lg);white-space:nowrap}
.gm-log{background:var(--clr-surface-2,var(--clr-surface));border:1px solid var(--clr-border);border-radius:var(--radius-lg);padding:var(--space-3);overflow:hidden;display:flex;flex-direction:column;max-height:100%}
.gm-log h2{font-size:var(--fs-base);margin:0 0 var(--space-2)}
.gm-log ul{list-style:none;margin:0;padding:0;overflow-y:auto;font-size:var(--fs-sm);font-family:var(--font-mono)}
.gm-log li{padding:3px 0;border-bottom:1px dashed var(--clr-border)}
.gm-log li.ok{color:var(--clr-success)} .gm-log li.bad{color:var(--clr-red)}
.gm-field{position:relative;display:flex;align-items:center;gap:var(--space-3);margin-top:var(--space-4);padding:var(--space-4);min-height:230px;background:var(--clr-surface-2,var(--clr-surface));border:1px solid var(--clr-border);border-radius:var(--radius-xl)}
.gm-hero{font-size:56px;transition:transform .6s var(--ease);flex:none}
.gm-reward{font-size:56px;flex:none;filter:grayscale(.6);transition:filter .3s,transform .3s}
.gm-reward.is-open{filter:none;transform:scale(1.25) rotate(-6deg)}
.gm-wall{flex:1;display:flex;gap:6px;justify-content:center;overflow-x:auto;padding:4px}
.gm-col{display:flex;flex-direction:column;gap:6px;justify-content:center}
.gm-brick{position:relative;min-width:74px;padding:14px 8px;border-radius:12px;text-align:center;font-weight:700;font-size:var(--fs-sm);background:#b45f4a;color:#fff;border:2px solid rgba(0,0,0,.25);transition:transform .35s,opacity .35s}
.gm-brick.is-target{outline:3px solid #facc15;animation:gmPulse 1s infinite}
.gm-brick.is-broken{transform:scale(.2) rotate(35deg) translateY(-40px);opacity:0;pointer-events:none}
.gm-brick.is-shake{animation:gmShake .35s}
.gm-brick::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;background:none}
.gm-brick[data-crack="1"]::after{background:linear-gradient(115deg,transparent 46%,rgba(0,0,0,.65) 47% 49%,transparent 50%)}
.gm-brick[data-crack="2"]::after{background:linear-gradient(115deg,transparent 46%,rgba(0,0,0,.65) 47% 49%,transparent 50%),linear-gradient(55deg,transparent 60%,rgba(0,0,0,.65) 61% 63%,transparent 64%)}
.gm-brick[data-crack="3"]::after{background:linear-gradient(115deg,transparent 46%,rgba(0,0,0,.75) 47% 50%,transparent 51%),linear-gradient(55deg,transparent 58%,rgba(0,0,0,.75) 59% 62%,transparent 63%),linear-gradient(170deg,transparent 30%,rgba(0,0,0,.75) 31% 33%,transparent 34%)}
@keyframes gmPulse{50%{outline-color:transparent}}
@keyframes gmShake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.gm-hint{min-height:1.5em;text-align:center;margin-top:var(--space-2)}
.gm-overlay{position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;background:rgba(15,23,42,.72);border-radius:var(--radius-xl)}
.gm-overlay[hidden]{display:none}
.gm-card{background:var(--clr-surface);color:var(--clr-text);border:1px solid var(--clr-border);border-radius:var(--radius-xl);padding:var(--space-8);max-width:420px;width:90%;text-align:center;display:flex;flex-direction:column;gap:var(--space-3);align-items:center}
.gm-field-row{display:flex;gap:var(--space-2);align-items:center}
.gm-chest{font-size:72px}
.gm-chest.is-open{animation:gmPop .6s}
@keyframes gmPop{50%{transform:scale(1.4) rotate(8deg)}}
.gm-stars{font-size:32px;letter-spacing:6px}
.gm-badges{display:flex;gap:var(--space-2);flex-wrap:wrap;justify-content:center}
.gm-badges span{padding:4px 10px;border-radius:var(--radius-pill);border:1px solid var(--clr-border);font-size:var(--fs-sm)}
@media (max-width:820px){.gm-top{grid-template-columns:1fr}.gm-log{max-height:140px}}
