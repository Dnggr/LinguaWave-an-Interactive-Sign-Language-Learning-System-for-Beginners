      .homepage-hero__actions .btn { width: 100%; }
    }

    /* Stats bar — real content counts (see js/data.js), not invented
       usage numbers. Reuses .card for the surface/border treatment. */
    .stats-bar {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: var(--space-4); margin-top: var(--space-8);
    }
    .stats-bar__item { text-align: center; padding: var(--space-5) var(--space-3); }
    .stats-bar__number {
      font-family: var(--font-display); font-size: var(--fs-2xl); font-weight: 700;
      color: var(--clr-accent); display: block;
    }
    .stats-bar__label { font-size: var(--fs-xs); color: var(--clr-text-muted); margin-top: var(--space-1); }

    /* Quote block — REDESIGNED (this session). Was a bare `"` character
       in a thin 2px-border circle, which read as under-designed/half-
       finished next to the rest of the page. Now a filled accent-soft
       badge (same "chip" language as .topic-card__icon/.icon-badge)
       holding a real quotation-mark glyph drawn as an inline SVG, sized
       up so it carries actual visual weight as its own small anchor for
       this section, the way the hero/topic-grid icons do for theirs. */
    .quote-block { max-width: 680px; margin: 0 auto; text-align: center; }
    .quote-block__mark {
      width: 64px; height: 64px; margin: 0 auto var(--space-5);
      border-radius: var(--radius-pill); background: var(--clr-accent-soft);
      display: flex; align-items: center; justify-content: center;
      color: var(--clr-accent);
    }
    .quote-block__mark svg { width: 42%; height: 42%; }
    .quote-block__text {
      font-family: var(--font-display); font-size: var(--fs-xl); line-height: 1.4;
    }

    /* Topic grid ("Subject Areas" equivalent) — 8 curated early units,
       each a real link into that unit via learn.html?unit=X. Not a
       live data.js query (would need homepage.js for no real benefit —
       these 8 ids/titles/icons are stable, hand-picked "start here"
       topics, not the full 71-unit catalog); if a featured unit's
       id/title ever changes in data.js, update this list to match. */
    .topic-grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4); margin-top: var(--space-6);
    }
    @media (max-width: 900px) { .topic-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .topic-grid { grid-template-columns: 1fr; } }
    .topic-card {
      display: flex; align-items: center; gap: var(--space-3);
      padding: var(--space-5) var(--space-4); background: var(--clr-surface);
      border: 1px solid var(--clr-border); border-radius: var(--radius-lg);
      text-decoration: none; color: var(--clr-text);
      transition: border-color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
    }
    .topic-card:hover {
      border-color: var(--clr-accent); transform: translateY(-2px);
      box-shadow: var(--shadow-card); text-decoration: none;
