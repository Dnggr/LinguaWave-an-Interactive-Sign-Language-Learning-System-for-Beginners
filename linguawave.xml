<file path="css/learn.css">
/* learn.css — Trail & Lesson Selector styles | CONNECTS: pages/learn.html */

/* ── Lesson grid: alphabet tiles ───────────────────────────────────── */
.lesson-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  gap: var(--space-4);
}
.lesson-card {
  display: flex; flex-direction: column; align-items: center; gap: var(--space-3);
  padding: var(--space-5) var(--space-4); background: var(--clr-surface);
  border: 1px solid var(--clr-border); border-radius: var(--radius-lg);
  text-align: center; text-decoration: none; color: var(--clr-text);
  transition: border-color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease), box-shadow var(--dur-base) var(--ease);
}
.lesson-card:hover:not(.lesson-card--locked) {
  border-color: var(--clr-accent); transform: translateY(-3px);
  box-shadow: var(--shadow-card); text-decoration: none;
}
.lesson-card--done { border-color: var(--clr-success); }
.lesson-card--current { border-color: var(--clr-accent); border-width: 2px; box-shadow: var(--shadow-card); }
.lesson-card--locked { opacity: .55; cursor: not-allowed; pointer-events: none; }
.lesson-card__letter {
  width: 52px; height: 52px; display: flex; align-items: center; justify-content: center;
  background: var(--clr-accent-soft); border-radius: var(--radius-md);
  font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 700; color: var(--clr-accent);
  transition: transform var(--dur-base) var(--ease);
}
.lesson-card:hover:not(.lesson-card--locked) .lesson-card__letter { transform: scale(1.08); }
.lesson-card__title { font-size: var(--fs-xs); color: var(--clr-text-muted); }

/* ── Category cards (Medium/Words + Intermediate/Phrases grids) ──────
   Name-only tiles: icon, title, status badge. No word-list preview —
   tap through to see what's actually inside a category. */
.lesson-grid--categories { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); }
.category-card { padding: var(--space-6) var(--space-4); }
.category-card__icon {
  font-size: var(--fs-2xl); line-height: 1;
  width: 56px; height: 56px; display: flex; align-items: center; justify-content: center;
  background: var(--clr-accent-soft); border-radius: var(--radius-pill);
  transition: transform var(--dur-base) var(--ease);
}
.lesson-card:hover:not(.lesson-card--locked) .category-card__icon { transform: scale(1.08); }
.category-card__title {
  font-family: var(--font-display); font-size: var(--fs-base); font-weight: 700;
  color: var(--clr-text); line-height: 1.3;
}

/* Category cards are rendered as <button> elements (they open the
   word/phrase picker instead of navigating directly) — reset button
   chrome so they still look like the rest of the grid. */
button.category-card {
  font: inherit; width: 100%; cursor: pointer;
}

/* ── Word/phrase picker ────────────────────────────────────────────
   Shown after tapping a category: one card per word/phrase inside it. */
.word-picker-card { align-items: flex-start; text-align: left; gap: var(--space-1); }
.word-picker-card .lesson-card__title { font-size: var(--fs-base); color: var(--clr-text); font-weight: 600; }
.word-picker-card__subtitle {
  font-size: var(--fs-xs); color: var(--clr-text-muted);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%;
}

/* ── Course grid + sidebar ("My Learning"-style) ──────────────────── */
.learn-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: var(--space-8);
  align-items: start;
}
.learn-main { min-width: 0; }
.learn-sidebar {
  display: flex; flex-direction: column; gap: var(--space-4);
  position: sticky; top: calc(60px + var(--space-6));
}
@media (max-width: 900px) {
  .learn-layout { grid-template-columns: 1fr; }
  .learn-sidebar { position: static; }
}

/* ── Search box ─────────────────────────────────────────────────────
   Filters whatever's currently rendered in #lesson-grid (see
   js/learn.js's applySearchFilter()) — previously wired to nothing at
   all (js/learn.js had no wireSearch()/input listener despite this
   file and pages/learn.html's own comments claiming it did), so typing
   here did nothing. Icon + clear button now give it the same affordance
   as any other search field instead of a bare unlabeled placeholder. */
.learn-search { position: relative; margin-bottom: var(--space-4); }
.learn-search__icon {
  position: absolute; left: var(--space-4); top: 50%; transform: translateY(-50%);
  width: 18px; height: 18px; color: var(--clr-text-muted); pointer-events: none;
}
.learn-search input {
  width: 100%; background: var(--clr-surface); color: var(--clr-text);
  border: 1px solid var(--clr-border); border-radius: var(--radius-pill);
  padding: var(--space-3) var(--space-8) var(--space-3) calc(var(--space-4) * 2 + 18px);
  font-size: var(--fs-sm); font-family: var(--font-body);
  transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}
.learn-search input::placeholder { color: var(--clr-text-muted); }
.learn-search input:focus {
  outline: none; border-color: var(--clr-accent);
  box-shadow: 0 0 0 3px var(--clr-accent-soft);
}
/* Chrome/Safari draw their own built-in "clear" control on
   type="search" inputs — suppress it so it doesn't double up with
   .learn-search__clear below. */
.learn-search input[type="search"]::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }
.learn-search__clear {
  position: absolute; right: var(--space-2); top: 50%; transform: translateY(-50%);
  width: 28px; height: 28px; border-radius: 50%; border: none; background: transparent;
  color: var(--clr-text-muted); font-size: var(--fs-sm); line-height: 1; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.learn-search__clear:hover { background: var(--clr-surface-2); color: var(--clr-text); }
.learn-search-empty { padding: var(--space-2) 0 var(--space-4); }
.is-search-hidden { display: none !important; }

/* CLEANUP (this revision) — removed the entire dead .course-grid/
   .course-card* rule family that used to live here. Confirmed via a
   full pages/+js/ search: no markup anywhere in the app emits
   .course-grid or any .course-card* class — learn.js's renderTrail()
   was reverted back to the .trail-group/.path-row shape further down
   this file (see AI_MEMORY.md's 09-06 "CATEGORY_GROUPS gap" entry),
   and this block was never cleaned up afterward. A matching dead
   .course-card:focus-visible rule further down this file was removed
   too — see that section's own note. */

/* ── Sidebar panels ─────────────────────────────────────────────────
   .sidebar-panel--continue (new) gives the "Continue Learning" panel
   the same accent-border + gradient-wash treatment css/dashboard.css's
   .continue-card already uses for the equivalent "what do you do
   next" card — this sidebar previously rendered both panels with
   identical, equally-neutral styling, so nothing on the page signaled
   which one was the primary action. */
.sidebar-panel {
  background: var(--clr-surface); border: 1px solid var(--clr-border);
  border-radius: var(--radius-xl); padding: var(--space-5);
}
.sidebar-panel--continue {
  border-color: var(--clr-accent);
  background: linear-gradient(135deg, var(--clr-accent-soft), transparent 60%);
}
.sidebar-panel__title {
  font-size: var(--fs-xs); font-weight: 700; text-transform: uppercase;
  letter-spacing: .06em; color: var(--clr-text-muted); margin-bottom: var(--space-3);
}

/* Progress ring — `--pct` (0–100) is set inline by js/learn.js's
   renderSidebar() and drives a conic-gradient arc, so the ring's fill
   is now the actual percentage; before this it was a flat, fixed-width
   circle that looked identical at 5% and 95% complete. The ::before
   punches the donut hole so only the arc + number/label show. */
.sidebar-progress__ring {
  --pct: 0;
  position: relative;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  width: 96px; height: 96px; margin: 0 auto; text-align: center;
  border-radius: 50%;
  background: conic-gradient(var(--clr-accent) calc(var(--pct) * 1%), var(--clr-accent-soft) 0);
}
.sidebar-progress__ring::before {
  content: ''; position: absolute; inset: 7px; border-radius: 50%;
  background: var(--clr-surface);
}
.sidebar-progress__number, .sidebar-progress__label { position: relative; z-index: 1; }
.sidebar-progress__number { font-family: var(--font-display); font-size: var(--fs-lg); font-weight: 700; color: var(--clr-accent); }
.sidebar-progress__label { font-size: var(--fs-xs); color: var(--clr-text-muted); }
.sidebar-progress__count { margin-top: var(--space-3); font-size: var(--fs-xs); color: var(--clr-text-muted); text-align: center; }

.sidebar-continue { display: flex; align-items: center; gap: var(--space-3); }
.sidebar-continue__icon {
  flex: 0 0 auto; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-xl); background: var(--clr-surface); border: 1px solid var(--clr-border);
  border-radius: var(--radius-pill);
}
.sidebar-continue__text { min-width: 0; }
.sidebar-continue__title { font-weight: 600; font-size: var(--fs-sm); margin-bottom: var(--space-1); }
.sidebar-continue__detail { font-size: var(--fs-xs); color: var(--clr-text-muted); overflow-wrap: anywhere; }
.sidebar-continue__empty { font-size: var(--fs-sm); color: var(--clr-text-muted); }

/* ── Trail groups (collapsible sections by curriculum chapter) ─────── */
.trail { display: flex; flex-direction: column; gap: var(--space-4); }
.trail-group {
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-lg);
  background: var(--clr-surface);
  overflow: hidden;
  /* ADDED (blue-teal mockup alignment pass) — matches the shadow every
     other card-like surface in the app already carries (.card,
     .lesson-card, .rec-card); chapter sections were flat by comparison. */
  box-shadow: var(--shadow-card);
  /* ADDED — js/learn.js's scrollToOpenChapter() scrolls the open chapter to the
     top of the viewport on load; this leaves a little air above its header. */
  scroll-margin-top: var(--space-6);
}
.trail-group__summary {
  display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
  padding: var(--space-4) var(--space-5);
  cursor: pointer; list-style: none; user-select: none;
  font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg);
  transition: background var(--dur-fast) var(--ease);
}
.trail-group__summary::-webkit-details-marker { display: none; }
.trail-group__summary::before {
  content: '▸'; display: inline-block; margin-right: var(--space-3);
  color: var(--clr-text-muted);
  transition: transform var(--dur-base) var(--ease);
}
.trail-group[open] > .trail-group__summary::before { transform: rotate(90deg); }
.trail-group__summary:hover { background: var(--clr-surface-2); }
.trail-group__summary:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--clr-accent); }
.trail-group__label { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.trail-group__title {}
.trail-group__blurb {
  font-family: var(--font-body); font-weight: 400; font-size: var(--fs-sm); color: var(--clr-text-muted);
  white-space: normal;
}
.trail-group__meta {
  font-family: var(--font-body); font-weight: 600; font-size: var(--fs-xs); color: var(--clr-text-muted);
  background: var(--clr-surface-2); padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill);
  white-space: nowrap;
}
/* Chapter 100% done (js/learn.js adds .trail-group--complete once
   doneCount === missionsInChapter.length) — border and the "x/x
   complete" pill switch to the same success color .badge--done and
   .path-row--done already use elsewhere in this app. */
.trail-group--complete { border-color: var(--clr-success); }
.trail-group--complete > .trail-group__summary > .trail-group__meta {
  background: var(--clr-success-soft); color: var(--clr-success);
}
/* Chapter-level "Locked" badge (js/learn.js) sat flush against the
   summary's right edge — .badge has no margin of its own, unlike
   .trail-group__meta's pill which reads the same padding but this is
   a plain .badge reused from elsewhere in the app. A little margin
   gives it the same breathing room the meta pill has. */
.trail-group__lock-badge { margin-right: var(--space-2); }
.trail-group__grid { padding: 0 var(--space-5) var(--space-5); }
/* A search that matches nothing left in this group (see
   js/learn.js's applySearchFilter()) — dimmed rather than removed, so
   the layout doesn't jump as the learner keeps typing. */
.trail-group.is-search-hidden { opacity: .35; }

/* ── :focus-visible ring ─────────────────────────────────────────────
   `.lesson-card` covers alphabet/number tiles, category cards, and the
   word/phrase picker. `:focus-visible` (not `:focus`) so a mouse click
   doesn't show a ring meant for keyboard use.
   CLEANUP (this revision) — dropped the paired `.course-card:focus-visible`
   selector; `.course-card` itself is dead (see this file's earlier note). */
.lesson-card:focus-visible {
  outline: none;
  box-shadow: 0 0 0 2px var(--clr-accent);
}

/* ── Loading / error fallback ─────────────────────────────────────── */
.learn-fallback-alert {
  grid-column: 1 / -1;
  margin: 0;
  border-radius: var(--radius-md);
}

/* ── Unit 0 info screen ────────────────────────────────────────────
   Prose content (window.LWData.UNIT0_CONTENT), not lesson cards — a
   plain-text block dropped full-width into #lesson-grid. */
.unit-info { grid-column: 1 / -1; max-width: 640px; }
.unit-info__section { margin-bottom: var(--space-6); }
.unit-info__section h3 { font-family: var(--font-display); margin-bottom: var(--space-2); }
.unit-info__section p { color: var(--clr-text-muted); line-height: 1.7; }
.unit-info .lesson-card--intro,
.unit-info .btn { margin-bottom: var(--space-6); }

/* ── Congrats modal (NEW) ─────────────────────────────────────────────
   Fires from js/learn.js's checkCompletion(), driven by a real
   state-change (a category/unit that just flipped to done) rather
   than a decorative animation — see that file's CONGRATS section.
   Pure CSS transform/opacity animation (no canvas/particle library),
   kept cheap on purpose given this session's performance focus. */
.congrats-modal {
  position: fixed; inset: 0; z-index: 200;
  display: flex; align-items: center; justify-content: center;
  padding: var(--space-4);
}
.congrats-modal[hidden] { display: none; }
.congrats-modal__backdrop {
  position: absolute; inset: 0;
  background: rgba(43, 33, 26, .45);
  animation: lw-fade-in var(--dur-base) var(--ease);
}
[data-theme="dark"] .congrats-modal__backdrop { background: rgba(0, 0, 0, .6); }
.congrats-modal__box {
  position: relative; width: 100%; max-width: 380px;
  background: var(--clr-surface); border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  padding: var(--space-8) var(--space-6) var(--space-6);
  text-align: center; overflow: hidden;
  animation: lw-modal-pop var(--dur-slow) var(--ease);
}
.congrats-modal__confetti {
  position: absolute; inset: 0; overflow: hidden; pointer-events: none;
}
.congrats-modal__confetti span {
  position: absolute; top: -8%; width: 8px; height: 8px; border-radius: 2px;
  opacity: 0; animation: lw-confetti-fall 1.5s ease-in forwards;
}
.congrats-modal__confetti span:nth-child(1) {
  left: 10%; background: var(--clr-accent); animation-delay: .05s;
}
.congrats-modal__confetti span:nth-child(2) {
  left: 25%; background: var(--clr-success); animation-delay: .15s;
}
.congrats-modal__confetti span:nth-child(3) {
  left: 45%; background: var(--clr-yellow); animation-delay: 0s;
}
.congrats-modal__confetti span:nth-child(4) {
  left: 62%; background: var(--clr-blue); animation-delay: .2s;
}
.congrats-modal__confetti span:nth-child(5) {
  left: 78%; background: var(--clr-accent); animation-delay: .1s;
}
.congrats-modal__confetti span:nth-child(6) {
  left: 92%; background: var(--clr-success); animation-delay: .25s;
}
.congrats-modal__icon {
  position: relative; font-size: 56px; line-height: 1;
  margin-bottom: var(--space-4);
}
.congrats-modal__title {
  position: relative; font-family: var(--font-display);
  margin-bottom: var(--space-2);
}
.congrats-modal__body {
  position: relative; color: var(--clr-text-muted);
  margin-bottom: var(--space-6);
}

@keyframes lw-confetti-fall {
  0%   { opacity: 1; transform: translateY(0) rotate(0deg); }
  100% { opacity: 0; transform: translateY(220px) rotate(200deg); }
}
@keyframes lw-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes lw-modal-pop {
  0%   { opacity: 0; transform: scale(.9) translateY(8px); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .congrats-modal__backdrop,
  .congrats-modal__box { animation: none; }
  .congrats-modal__confetti { display: none; }
}
