<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Sets data-theme before any CSS loads, so the page never
       flashes the wrong theme on load. Must stay first in <head>. -->
  <script>
    (function () {
      var pref = localStorage.getItem('lw-theme') || 'system';
      var resolved = pref === 'system'
        ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
        : pref;
      var root = document.documentElement;
      root.setAttribute('data-theme', resolved);
      root.setAttribute('data-theme-pref', pref);
      root.style.colorScheme = resolved;
      root.style.background = resolved === 'light' ? '#F8FAFC' : '#0F172A';
    })();
  </script>
  <!--
    pages/feedback.html — Survey-Based Feedback
    ─────────────────────────────────────────────────────────────────
    MOVED (V1-removal pass) from pages/feedback.html so is a
    complete, standalone app shell. Content/logic UNCHANGED — still
    js/feedback.js (V1 controller, reused as-is per the plan's
    "reuse existing V1 feedback & settings" decision). Only the
    surrounding chrome changed: sidebar (Dashboard/Learn/Progress/
    Feedback/Settings, no more Quiz/dev-link items), paths adjusted
    one level deeper (../ instead of ../), and the post-submit /
    skip redirects now point at dashboard.html instead of
    pages/dashboard.html. js/quiz.js's post-level-complete link was
    updated to point here (see CHANGELOG for this pass).

    CONNECTS : ← pages/quiz.html (redirected here after level complete)
               → dashboard.html (on survey submit / skip)

    URL PARAMS: ?level=basic | medium | intermediate
    ─────────────────────────────────────────────────────────────────
  -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Feedback | LinguaWave</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../css/style.css" />
  <link rel="stylesheet" href="../css/feedback.css" />
  <link rel="stylesheet" href="../css/app.css" />

  <script type="module" src="../js/auth.js"></script>
  <!-- Shared icon system. Plain <script> (not a module) and NOT deferred:
       window.LWIcons must exist before any page script, inline script or
       module body runs, and before DOMContentLoaded hydrates any
       data-lw-icon="" markup below. See js/icons.js. -->
  <script src="../js/icons.js"></script>
  <script src="../js/theme.js" defer></script>
  <script>
  window.addEventListener('lwauth-ready', () => {
    LWAuth.requireAuth('../index.html');
  });
  </script>
  <!-- Role guard: admin -> admin pages only, learners -> out of admin pages. Keep synchronous, in <head>. -->
  <script src="../js/role-guard.js"></script>
</head>
<body>

<div class="app-shell">
    <aside class="app-sidebar">
      <a href="dashboard.html" class="app-sidebar__logo">Lingua<span>Wave</span></a>
