<file path="js/game.js">
/*
  js/game.js — Wall Breaker (standalone; does NOT modify any engine file)
  Reuses: cameraUtils, mediapipe, classifier, dictionary, renderer (read-only).
  Rules:
   - Sign the highlighted brick. Static = hold ~0.5s. Motion = 3-2-1 then sign.
   - A confident WRONG sign (or a failed motion attempt) CRACKS the brick (max 3 stages, cosmetic).
   - Correct sign smashes it. Clear the wall -> chest reward (stars + gems + badges, saved in localStorage 'lw_game_v1').
  Lifecycle: stopCamera + cancelAnimationFrame + all timers cleared on pagehide/hidden.
*/
import { startCamera, stopCamera } from './camera/cameraUtils.js';
import { initMediaPipe, processFrame, isModelReady } from './tracking/mediapipe.js';
import { drawSkeleton, clearCanvas } from './engine/renderer.js';
import { getDetectionType, getActiveSigns, getSignData } from './engine/dictionary.js';
import { classifyGesture, classifyMotion, resetMotionBuffer, finalizeMotionWindow,
         loadModels, isMotionModelReady, getAllowedLabelsForSign } from './engine/classifier.js';

const $ = (id) => document.getElementById(id);
const videoEl = $('lw-webcam'), canvasEl = $('lw-canvas'), ctx = canvasEl.getContext('2d');

const HOLD_MS = 500, WRONG_HOLD_MS = 450, CRACK_COOLDOWN_MS = 1200;
const HAND_LOST_MS = 1200, COUNTDOWN = ['3', '2', '1', 'GO!'], COUNT_STEP_MS = 450;
const HINT_AFTER_MS = 9000, ROWS = 3, STORE = 'lw_game_v1';

let bricks = [], idx = 0, running = false, rafId = null, timers = new Set();
let stats, startedAt = 0, tickId = null, engineReady = false, booting = false;
let holdSince = 0, wrongSince = 0, wrongLabel = null, lastCrackAt = 0, brickStartAt = 0;
let motionArmed = false, counting = false, handLostAt = null, locked = false;

// ── storage ───────────────────────────────────────────────────────
function load() {
  try { return Object.assign({ gems: 0, walls: 0, badges: [], best: {} }, JSON.parse(localStorage.getItem(STORE) || '{}')); }
  catch { return { gems: 0, walls: 0, badges: [], best: {} }; }
}
function save(d) { try { localStorage.setItem(STORE, JSON.stringify(d)); } catch { /* private mode */ } }

// ── helpers ───────────────────────────────────────────────────────
const later = (fn, ms) => { const t = setTimeout(() => { timers.delete(t); fn(); }, ms); timers.add(t); return t; };
const clearTimers = () => { timers.forEach(clearTimeout); timers.clear(); };
const fmt = (ms) => { const s = Math.floor(ms / 1000); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };
const shuffle = (a) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.random() * (i + 1) | 0; [a[i], a[j]] = [a[j], a[i]]; } return a; };
const setStatus = (msg) => { const el = $('camera-status'); el.textContent = msg; el.style.display = msg ? 'flex' : 'none'; };

function log(text, cls) {
  const ul = $('gm-log'), li = document.createElement('li');
  li.className = cls; li.textContent = text;
  ul.prepend(li);
  while (ul.children.length > 30) ul.lastChild.remove();
}

// ── sign pool: learned signs first, topped up with any enabled sign ─
async function buildPool(size) {
  let learned = [];
  try {
    await window.LWProgress?.whenProgressReady?.();
    learned = (window.LWProgress?.getAllLearnedSigns?.() || []).map(s => s.signId);
  } catch { /* progress not ready — fall back below */ }
  const active = new Set(getActiveSigns());
  const motionOk = isMotionModelReady();
  const usable = (s) => active.has(s) && (getDetectionType(s) !== 'motion' || motionOk);
  let pool = [...new Set(learned)].filter(usable);
  if (pool.length < 8) pool = pool.concat(shuffle(getActiveSigns().filter(usable).filter(s => !pool.includes(s))).slice(0, 8 - pool.length));
  pool = shuffle(pool);
  const out = [];
  while (out.length < size) out.push(...shuffle([...pool]));   // repeat if pool < size
  return out.slice(0, size);
}

// ── wall ──────────────────────────────────────────────────────────
function renderWall() {
  const wall = $('gm-wall'); wall.innerHTML = '';
  let col;
  bricks.forEach((b, i) => {
    if (i % ROWS === 0) { col = document.createElement('div'); col.className = 'gm-col'; wall.appendChild(col); }
    const el = document.createElement('div');
    el.className = 'gm-brick'; el.textContent = b.sign; el.dataset.crack = '0';
    b.el = el; col.appendChild(el);
  });
  $('gm-hero').style.transform = 'translateX(0)';
  $('gm-reward').classList.remove('is-open');
  $('gm-count').textContent = `0/${bricks.length}`;
}

function focusBrick() {
  const b = bricks[idx]; if (!b) return;
  bricks.forEach((x, i) => x.el.classList.toggle('is-target', i === idx));
  $('gm-target').textContent = `Sign: ${b.sign}`;
  $('gm-hint').textContent = '';
  b.el.scrollIntoView?.({ block: 'nearest', inline: 'center', behavior: 'smooth' });
  holdSince = 0; wrongSince = 0; wrongLabel = null; brickStartAt = Date.now();
  resetMotionBuffer(); motionArmed = false; handLostAt = null; locked = false;
  if (getDetectionType(b.sign) === 'motion') startCountdown(0);
  later(showHint, HINT_AFTER_MS);
}

function showHint() {
  const b = bricks[idx]; if (!running || !b) return;
  const d = getSignData(b.sign)?.description;
  $('gm-hint').textContent = d ? `Hint: ${d}` : 'Hint: open Learn to review this sign.';
}

function startCountdown(i) {
  if (!running) return;
  counting = true; motionArmed = false;
  if (i >= COUNTDOWN.length) { counting = false; motionArmed = true; resetMotionBuffer(); $('gm-target').textContent = `Sign: ${bricks[idx].sign}  ●`; return; }
  $('gm-target').textContent = `${bricks[idx].sign} — ${COUNTDOWN[i]}`;
  later(() => startCountdown(i + 1), COUNT_STEP_MS);
}

function crack(label) {
  const b = bricks[idx]; if (!b || locked) return;
  lastCrackAt = Date.now(); stats.wrong++;
  const n = Math.min(3, (+b.el.dataset.crack || 0) + 1);
  b.el.dataset.crack = String(n);
  b.el.classList.remove('is-shake'); void b.el.offsetWidth; b.el.classList.add('is-shake');
  log(`✗ ${label || '?'} (need ${b.sign})`, 'bad');
  holdSince = 0; wrongSince = 0; wrongLabel = null;
}

function smash() {
  const b = bricks[idx]; if (!b || locked) return;
  locked = true; motionArmed = false; stats.correct++;
  b.el.classList.remove('is-target'); b.el.classList.add('is-broken');
  log(`✓ ${b.sign}`, 'ok');
  idx++;
  $('gm-count').textContent = `${idx}/${bricks.length}`;
  const cols = Math.floor(idx / ROWS), colW = (b.el.parentElement.offsetWidth || 80) + 6;
  $('gm-hero').style.transform = `translateX(${Math.min(cols, Math.ceil(bricks.length / ROWS)) * colW * 0.9}px)`;
  if (idx >= bricks.length) later(finish, 700); else later(focusBrick, 650);
}

// ── main loop ─────────────────────────────────────────────────────
function loop() {
  rafId = requestAnimationFrame(loop);
  if (!videoEl || videoEl.readyState < 2) return;
  const { leftHandLandmarks: L, rightHandLandmarks: R, faceLandmarks: F, poseLandmarks: P, anyHandPresent } = processFrame(videoEl);
  const hands = [L, R].filter(Boolean);
  if (hands.length) drawSkeleton(ctx, hands, canvasEl.width, canvasEl.height); else clearCanvas(ctx, canvasEl.width, canvasEl.height);
  if (!running || locked || idx >= bricks.length) return;

  const target = bricks[idx].sign, now = Date.now();
  const allowed = getAllowedLabelsForSign(target);

  if (getDetectionType(target) === 'motion') {
    if (counting) return;
    if (!anyHandPresent) {
      if (motionArmed) {
        handLostAt ??= now;
        if (now - handLostAt > HAND_LOST_MS) { motionArmed = false; handLostAt = null; motionDone(finalizeMotionWindow(allowed, target)); }
      }
      return;
    }
    handLostAt = null;
    if (!motionArmed) return;
    const r = classifyMotion(L, R, F, allowed, P, target);
    if (!r.buffering) { motionArmed = false; motionDone(r); }
    return;
  }

  if (!anyHandPresent) { holdSince = 0; wrongSince = 0; return; }
  const r = classifyGesture(L, R, F, allowed, P, target);
  if (r.matched && r.label === target) {
    holdSince ||= now; wrongSince = 0;
    if (now - holdSince >= HOLD_MS) smash();
  } else if (r.matched && r.label) {
    holdSince = 0;
    if (r.label !== wrongLabel) { wrongLabel = r.label; wrongSince = now; }
    if (now - wrongSince >= WRONG_HOLD_MS && now - lastCrackAt > CRACK_COOLDOWN_MS) crack(r.label);
  } else { holdSince = 0; wrongSince = 0; wrongLabel = null; }
}

function motionDone(r) {
  const target = bricks[idx]?.sign;
  if (r && r.matched && r.label === target) return smash();
  crack(r?.label || null);
  later(() => { if (running && !locked) startCountdown(0); }, 900);   // retry, same brick
}

// ── game flow ─────────────────────────────────────────────────────
async function bootEngine() {
  if (engineReady || booting) return engineReady;
  booting = true;
  try {
    setStatus('Loading hand tracking…'); await initMediaPipe();
    setStatus('Starting camera…');       await startCamera(videoEl, canvasEl);
    setStatus('Loading sign models…');   await loadModels();
    if (!isModelReady()) throw new Error('Hand tracking model failed to load');
    setStatus(''); engineReady = true;
  } catch (e) {
    console.error('[game] boot failed:', e);
    setStatus(`Could not start: ${e.message}`);
  }
  booting = false;
  return engineReady;
}

async function startGame() {
  const size = +$('gm-size').value;
  $('gm-btn-start').disabled = true;
  if (!(await bootEngine())) { $('gm-btn-start').disabled = false; return; }
  clearTimers();
  const signs = await buildPool(size);
  bricks = signs.map(sign => ({ sign, el: null })); idx = 0;
  stats = { correct: 0, wrong: 0, size };
  renderWall();
  $('gm-start').hidden = true; $('gm-result').hidden = true;
  $('gm-log').innerHTML = '';
  $('gm-gems').textContent = load().gems;
  running = true; startedAt = Date.now();
  clearInterval(tickId); tickId = setInterval(() => { $('gm-time').textContent = fmt(Date.now() - startedAt); }, 500);
  if (!rafId) loop();
  focusBrick();
}

function finish() {
  running = false; clearInterval(tickId); clearTimers();
  const ms = Date.now() - startedAt, total = stats.correct + stats.wrong;
  const acc = total ? stats.correct / total : 1;
  const stars = acc >= 0.85 ? 3 : acc >= 0.6 ? 2 : 1;
  const gems = stats.size + stars * 5;
  const d = load(), earned = [];
  const add = (id, label) => { if (!d.badges.includes(id)) { d.badges.push(id); earned.push(label); } };
  d.gems += gems; d.walls++;
  add('first', '🧱 First Wall');
  if (stats.wrong === 0) add('flawless', '💎 Flawless');
  if (ms / stats.size <= 6000) add('speed', '⚡ Speed Breaker');
  if (d.walls >= 5) add('veteran', '🏗️ Wall Veteran');
  const prev = d.best[stats.size];
  if (!prev || stars > prev.stars || (stars === prev.stars && ms < prev.ms)) d.best[stats.size] = { stars, ms };
  save(d);

  $('gm-reward').classList.add('is-open'); $('gm-gems').textContent = d.gems;
  $('gm-stars').textContent = '★'.repeat(stars) + '☆'.repeat(3 - stars);
  $('gm-result-title').textContent = 'Wall cleared!';
  $('gm-result-text').textContent = `${fmt(ms)} · ${Math.round(acc * 100)}% accuracy · +${gems} gems`;
  $('gm-badges').innerHTML = ''; earned.forEach(t => { const s = document.createElement('span'); s.textContent = t; $('gm-badges').appendChild(s); });
  $('gm-chest').classList.remove('is-open'); void $('gm-chest').offsetWidth;
  $('gm-chest').textContent = '🎉'; $('gm-chest').classList.add('is-open');
  $('gm-result').hidden = false; $('gm-btn-start').disabled = false;
  showBest();
}

function showBest() {
  const b = load().best[$('gm-size').value];
  $('gm-best').textContent = b ? `Best: ${'★'.repeat(b.stars)} in ${fmt(b.ms)}` : '';
}

function shutdown() {
  running = false; clearTimers(); clearInterval(tickId);
  if (rafId) cancelAnimationFrame(rafId); rafId = null;
  stopCamera(videoEl); engineReady = false;
}

// ── wire up ───────────────────────────────────────────────────────
$('gm-btn-start').addEventListener('click', startGame);
$('gm-btn-again').addEventListener('click', () => { $('gm-result').hidden = true; startGame(); });
$('gm-size').addEventListener('change', showBest);
window.addEventListener('pagehide', shutdown);
document.addEventListener('visibilitychange', () => { if (document.hidden && running) { shutdown(); $('gm-start').hidden = false; setStatus('Camera paused. Press Start to resume.'); } });
$('gm-gems').textContent = load().gems;
showBest();
</file>

