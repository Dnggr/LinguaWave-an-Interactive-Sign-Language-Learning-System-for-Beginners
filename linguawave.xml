      font-size: var(--fs-xs); font-weight: 600; text-decoration: none;
      margin-bottom: var(--space-5);
    }
    .hero-banner:hover { text-decoration: underline; }
    .hero-banner .icon-badge { width: 18px; height: 18px; }
    .hero-banner .icon-badge svg { width: 100%; height: 100%; }
    .homepage-hero { max-width: 720px; }
    .homepage-hero h1 {
