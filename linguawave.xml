  <div id="auth-modal" class="auth-modal hidden">
    <div class="auth-modal__box">
      <p id="auth-modal-message" class="auth-modal__message"></p>
      <button id="auth-modal-close" class="btn btn--primary btn--full">OK</button>
    </div>
  </div>

  <script src="js/main.js"></script>
  <script>
    'use strict';

    // Slides the blue pill behind the active tab instead of each
    // button's background fading in/out on its own (which, both
    // firing at once, read as a flash rather than a single motion).
    // animate=false is used right after the modal opens, so the pill
    // snaps straight to the right tab instead of sliding in from 0.
    const authTabsIndicator = document.getElementById('auth-tabs-indicator');
    function positionAuthTabsIndicator(animate) {
      const loginTab    = document.getElementById('tab-login');
      const registerTab = document.getElementById('tab-register');
      const activeTab   = loginTab.classList.contains('auth-tab--active') ? loginTab : registerTab;
      if (!activeTab.offsetWidth) return; // modal not visible yet — nothing to measure

      if (!animate) authTabsIndicator.style.transition = 'none';
      authTabsIndicator.style.width = activeTab.offsetWidth + 'px';
      authTabsIndicator.style.transform = `translateX(${activeTab.offsetLeft - loginTab.offsetLeft}px)`;
      if (!animate) {
        void authTabsIndicator.offsetWidth; // force reflow before re-enabling the transition
        authTabsIndicator.style.transition = '';
      }
    }
    window.addEventListener('resize', () => positionAuthTabsIndicator(false));

    // Crossfades the login/register forms instead of snapping their
    // display on/off, so switching tabs reads as one smooth motion
    // rather than an instant cut. See .auth-form--fade-out /
    // .auth-form--fade-in-start in css/auth.css for the timing.
    function showAuthTab(tab) {
      const isLogin = tab === 'login';
      const loginForm    = document.getElementById('login-form');
      const registerForm = document.getElementById('register-form');
      const showEl = isLogin ? loginForm : registerForm;
      const hideEl = isLogin ? registerForm : loginForm;

      document.getElementById('tab-login').classList.toggle('auth-tab--active', isLogin);
      document.getElementById('tab-register').classList.toggle('auth-tab--active', !isLogin);
      positionAuthTabsIndicator(true);

      // Already on this tab (or mid-transition into it) — nothing to animate.
      if (showEl.style.display === 'flex' && !showEl.classList.contains('auth-form--fade-in-start')) return;

      // Cancel any in-flight transition on either form so rapid tab
      // clicks can't leave things in a half-faded state.
      loginForm.classList.remove('auth-form--fade-out', 'auth-form--fade-in-start');
      registerForm.classList.remove('auth-form--fade-out', 'auth-form--fade-in-start');

      hideEl.classList.add('auth-form--fade-out');

      window.setTimeout(() => {
        hideEl.style.display = 'none';
        hideEl.classList.remove('auth-form--fade-out');

        showEl.style.display = 'flex';
        showEl.classList.add('auth-form--fade-in-start');
        void showEl.offsetWidth; // force reflow so the fade-in actually transitions
        showEl.classList.remove('auth-form--fade-in-start');
      }, 160);
    }

    // ── SIGN IN MODAL open/close ────────────────────────────────────
    // Matches the mockup: the hero has no inline form, so "Start
    // Learning" (hero), "Sign In" (nav), and "Learn" (nav link, which
    // needs an account to actually open) all funnel into this one
    // modal, pre-set to the tab that makes sense for which one was
    // clicked. "Home" (formerly "Dashboard") no longer funnels here —
    // see the scrollToTop() binding below.
    const signinModal = document.getElementById('signin-modal');

    function openAuthModal(tab) {
      showAuthTab(tab);
      signinModal.classList.remove('hidden');
      positionAuthTabsIndicator(false); // modal was hidden during showAuthTab(), so snap now that it's visible
      document.getElementById(tab === 'login' ? 'login-email' : 'reg-name').focus();
    }
    function closeAuthModal() {
      signinModal.classList.add('hidden');
    }

    // Logo + "Home" nav link click — this is the landing page itself,
    // so clicking either should just take the visitor back to the top
    // of THIS page (like every other marketing site), not force a
    // full navigation/reload to "index.html" (which is where they
    // already are). "Home" replaces the old "Dashboard" link, which
    // required an account and opened the sign-in modal via
    // data-hero-login; it now just mirrors the logo instead.
    function scrollToTop(event) {
      event.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    document.getElementById('navbar-logo').addEventListener('click', scrollToTop);
    document.getElementById('navbar-home').addEventListener('click', scrollToTop);

    document.getElementById('signin-modal-close').addEventListener('click', closeAuthModal);
    signinModal.addEventListener('click', (event) => {
      if (event.target === signinModal) closeAuthModal(); // click on the backdrop
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !signinModal.classList.contains('hidden')) closeAuthModal();
    });

    // "Start Learning" / topic-preview chips open the modal on Sign Up;
    // "Sign In" / Learn nav link open it on Log In. ("Home" is bound
    // separately, above, to scrollToTop instead.)
    document.querySelectorAll('[data-hero-cta]').forEach((el) => {
      el.addEventListener('click', () => openAuthModal('register'));
    });
    document.querySelectorAll('[data-hero-login]').forEach((el) => {
      el.addEventListener('click', (event) => {
        event.preventDefault();
        openAuthModal('login');
      });
    });

    async function handleLogin() {
      const email    = document.getElementById('login-email').value;
      const password = document.getElementById('login-password').value;
      try {
        await LWAuth.login(email, password);
        await LWAuth.linkPendingGoogleCredential(); // no-op unless a Google sign-in just flagged a conflict
        window.location.href = lwPostAuthPath();
      } catch (error) {
        showAuthModal(error.message)
      }
    }

    // REV 4 PHASE 5: no more reg-level field to read — everyone starts
    // at the same place (Unit 0), so LWAuth.register() no longer takes
    // a level argument. See js/auth.js's register() for the matching change.
    // ── EMAIL TYPO HINT (self-contained, no external library) ───────
    // Instant, client-side, zero network calls. Catches the common
    // "close but wrong" domain typo (gmail.co, gmial.com, yaho.com...)
    // the moment the learner leaves the field. This is a courtesy nudge,
    // not a hard block — the real gate is checkEmailDomain() (a Cloud
    // Function doing an actual DNS lookup), called inside LWAuth.register().
    const COMMON_EMAIL_DOMAINS = [
      'gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com',
      'icloud.com', 'aol.com', 'protonmail.com', 'live.com'
    ];

    // Plain Levenshtein edit distance — small, dependency-free.
    function editDistance(a, b) {
      const dp = Array.from({ length: a.length + 1 }, (_, i) =>
        Array(b.length + 1).fill(0).map((_, j) => (i === 0 ? j : 0))
      );
      for (let i = 0; i <= a.length; i++) dp[i][0] = i;
      for (let j = 0; j <= b.length; j++) dp[0][j] = j;
      for (let i = 1; i <= a.length; i++) {
        for (let j = 1; j <= b.length; j++) {
          dp[i][j] = a[i - 1] === b[j - 1]
            ? dp[i - 1][j - 1]
            : 1 + Math.min(dp[i - 1][j], dp[i][j - 1], dp[i - 1][j - 1]);
        }
      }
      return dp[a.length][b.length];
    }

    function suggestEmailDomain(email) {
      const at = email.lastIndexOf('@');
      if (at < 1 || at === email.length - 1) return null;
      const domain = email.slice(at + 1).toLowerCase();
      if (COMMON_EMAIL_DOMAINS.includes(domain)) return null; // already correct

      let best = null;
      let bestDist = Infinity;
      for (const candidate of COMMON_EMAIL_DOMAINS) {
        const dist = editDistance(domain, candidate);
        if (dist < bestDist) { bestDist = dist; best = candidate; }
      }
      // Only suggest for a SMALL typo (1-2 characters off), so we don't
      // nag someone using a real, uncommon domain (school email, etc.).
      return bestDist > 0 && bestDist <= 2 ? best : null;
    }

    function checkEmailTypo() {
      const input = document.getElementById('reg-email');
      const hint = document.getElementById('reg-email-hint');
      const suggestion = suggestEmailDomain(input.value.trim());
      if (suggestion) {
        const [local] = input.value.trim().split('@');
        hint.innerHTML = 'Did you mean <a href="#" onclick="fixEmailDomain(\'' + suggestion + '\'); return false;">' +
          local + '@' + suggestion + '</a>?';
        hint.style.display = 'block';
      } else {
        hint.style.display = 'none';
      }
    }

    function fixEmailDomain(domain) {
      const input = document.getElementById('reg-email');
      const [local] = input.value.trim().split('@');
      input.value = local + '@' + domain;
      document.getElementById('reg-email-hint').style.display = 'none';
    }

    async function handleRegister() {
      const name     = document.getElementById('reg-name').value;
      const email    = document.getElementById('reg-email').value;
      const password = document.getElementById('reg-password').value;
      try {
        await LWAuth.register(name, email, password);
        // register() always throws — even on success — because it no
        // longer logs the learner in directly (see js/auth.js). The
        // line above never actually returns.
      } catch (error) {
        if (error && error.code === 'lw/verify-email-sent') {
          showAuthTab('login');
          showAuthModal(error.message);
          return;
        }
        showAuthModal(error.message)
      }
    }

    // "Resend verification email" link on the Log In form — reuses
    // whatever the learner already typed into the login email/password
    // fields (Firebase requires proving you own the account before it
    // will resend the link, so a password is needed here too).
    async function handleResendVerification() {
      const email    = document.getElementById('login-email').value;
      const password = document.getElementById('login-password').value;
      if (!email || !password) {
        showAuthModal('Enter your email and password above first, then tap "Resend it".');
        return;
      }
      try {
        await LWAuth.resendVerificationEmail(email, password);
        showAuthModal('Verification email resent to ' + email + ' — check your inbox (and spam folder).');
      } catch (error) {
        if (error && error.code === 'lw/already-verified') {
          showAuthModal(error.message);
          return;
        }
        showAuthModal(error.message || "Couldn't resend the email. Double-check your email and password.");
      }
    }

    async function handleGoogleSignIn() {
      try {
        await LWAuth.loginWithGoogle();
        window.location.href = lwPostAuthPath();
      } catch (error) {
        if (error && error.code === 'auth/popup-closed-by-user') return;
        if (error && error.code === 'auth/account-exists-with-different-credential') {
          showAuthTab('login');
          showAuthModal("An account with this email already exists. Log in with your password below to link Google to it — you'll only need to do this once.");
          return;
        }
        showAuthModal(error.message);
      }
    }

     const authModal = document.getElementById('auth-modal');
     const authModalMessage = document.getElementById('auth-modal-message');
     const authModalClose = document.getElementById('auth-modal-close');

     function showAuthModal(message) {
       authModalMessage.textContent = message;
       authModal.classList.remove('hidden');
     }

     authModalClose.addEventListener('click', () => {
       authModal.classList.add('hidden');
     });
  </script>
</body>
</html>
